import Mathlib

/-!
Exponent 7: definitions.

The certificate rows below are generated from `certificate.json` (51 rows: 6 bootstrap, 45 ladder).
A row `⟨Q, X⟩` is the claim, established outside Lean by the explicit-formula certificate
(Steps 2 and 3 of the note, assuming GRH), that every prime `q ≡ 3 (mod 4)` with `X < q ≤ Q` has a
prime below `X` that splits in `ℚ(√-q)`.
-/

namespace Exp7

/-- Splitting of a prime `p ≠ q` in `ℚ(√-q)` for a prime `q ≡ 3 (mod 4)`, by the Dedekind–Kummer
criterion: `2` splits iff `-q ≡ 1 (mod 8)`, i.e. `q ≡ 7 (mod 8)`; an odd prime `p` splits iff
`(-q / p) = 1`. -/
def Splits (q p : ℕ) : Prop :=
  if p = 2 then q % 8 = 7 else jacobiSym (-(q : ℤ)) p = 1

/-- A certificate row. -/
