def allRows : List Row := bootstrapRows ++ ladderRows

/-- The lower bound for `q` used by the search for the candidate least split prime `p`:
the maximum of `QLOW` and of `Q` over all rows with `X ≤ p`. -/
def Qlo (p : ℕ) : ℕ :=
  (allRows.filter (fun r => r.X ≤ p)).foldr (fun r acc => max r.Q acc) QLOW

