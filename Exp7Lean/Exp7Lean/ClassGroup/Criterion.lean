import Exp7Lean.ClassGroup.Converse

/-!
Exponent 7: the criterion.

If the class group is generated by the classes of the `(l, ω - t)` with `l ≤ N` (`GenBound q N`)
and each of these classes is killed by 7, then every class is killed by 7. With one non-trivial
class the exponent is 7; if all generators are trivial the class group is trivial.

The second half of the file is a certificate checker: a list of certificates, one for each
`l = 2, 3, …`, each saying that `l` is composite, or that `X^2 - X - a` has no root modulo `l`, or
giving a solution of `4 l^n = x^2 + q y^2` with `l ∤ y`. The checker is a `Bool`-valued function,
evaluated by the kernel on the data of `KnownData.lean`.
-/

namespace Exp7

open QuadraticAlgebra

open scoped nonZeroDivisors

section

variable {q : ℕ} [hq : Fact q.Prime] [h4 : Fact (q % 4 = 3)]

lemma classOf_eq_one_iff {l : ℕ} (hl : l ≠ 0) (t : ℤ) :
    classOf q l hl t = 1 ↔ (idealI q l t).IsPrincipal :=
  ClassGroup.mk0_eq_one_iff _

lemma classOf_pow_eq_one_iff {l : ℕ} (hl : l ≠ 0) (t : ℤ) (n : ℕ) :
    classOf q l hl t ^ n = 1 ↔ (idealI q l t ^ n).IsPrincipal := by
  have hImem : idealI q l t ∈ (Ideal (OK q))⁰ :=
    mem_nonZeroDivisors_of_ne_zero (idealI_ne_bot hl t)
  have hpow : idealI q l t ^ n ∈ (Ideal (OK q))⁰ := pow_mem hImem n
  rw [← ClassGroup.mk0_eq_one_iff hpow]
  have e : (⟨idealI q l t ^ n, hpow⟩ : (Ideal (OK q))⁰) = ⟨idealI q l t, hImem⟩ ^ n :=
    Subtype.ext (by simp)
  rw [e, map_pow]
  rfl

/-- If the generators of `GenBound q N` are killed by `n`, so is every class. -/
theorem pow_eq_one_of_genBound {N : ℕ} (hg : GenBound q N) (n : ℕ)
    (hn : ∀ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N → (l : ℤ) ∣ t ^ 2 - t - aOf q →
      classOf q l hl.ne_zero t ^ n = 1) :
    ∀ c : ClassGroup (OK q), c ^ n = 1 := by
  intro c
  have hle : Subgroup.closure {c : ClassGroup (OK q) | ∃ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N ∧
      (l : ℤ) ∣ t ^ 2 - t - aOf q ∧ c = classOf q l hl.ne_zero t} ≤
      (powMonoidHom n : ClassGroup (OK q) →* ClassGroup (OK q)).ker := by
    rw [Subgroup.closure_le]
    rintro c ⟨l, hl, t, hlN, ht, rfl⟩
    exact hn l hl t hlN ht
  have hmem : c ∈ (powMonoidHom n : ClassGroup (OK q) →* ClassGroup (OK q)).ker :=
    hle (by rw [show Subgroup.closure _ = ⊤ from hg]; trivial)
  simpa using hmem

/-- **Criterion.** If the generators of `GenBound q N` are killed by 7, every class is. -/
theorem pow_seven_eq_one_of_genBound {N : ℕ} (hg : GenBound q N)
    (h7 : ∀ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N → (l : ℤ) ∣ t ^ 2 - t - aOf q →
      classOf q l hl.ne_zero t ^ 7 = 1) :
    ∀ c : ClassGroup (OK q), c ^ 7 = 1 :=
  pow_eq_one_of_genBound hg 7 h7

/-- **Criterion, exponent 7.** If moreover some class is non-trivial, the exponent is 7. -/
theorem exponent_eq_seven_of_genBound {N : ℕ} (hg : GenBound q N)
    (h7 : ∀ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N → (l : ℤ) ∣ t ^ 2 - t - aOf q →
      classOf q l hl.ne_zero t ^ 7 = 1)
    (hne : ∃ c : ClassGroup (OK q), c ≠ 1) :
    Monoid.exponent (ClassGroup (OK q)) = 7 := by
  have hdvd : Monoid.exponent (ClassGroup (OK q)) ∣ 7 :=
    Monoid.exponent_dvd_of_forall_pow_eq_one (pow_seven_eq_one_of_genBound hg h7)
  rcases (Nat.dvd_prime (by norm_num : Nat.Prime 7)).mp hdvd with h1 | h1
  · exfalso
    have hsub : Subsingleton (ClassGroup (OK q)) := Monoid.exp_eq_one_iff.mp h1
    obtain ⟨c, hc⟩ := hne
    exact hc (Subsingleton.elim c 1)
  · exact h1

/-- **Criterion, trivial class group.** If all generators of `GenBound q N` are trivial, every
class is trivial. -/
theorem eq_one_of_genBound {N : ℕ} (hg : GenBound q N)
    (h1 : ∀ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N → (l : ℤ) ∣ t ^ 2 - t - aOf q →
      classOf q l hl.ne_zero t = 1) :
    ∀ c : ClassGroup (OK q), c = 1 := by
  intro c
  have := pow_eq_one_of_genBound hg 1
    (fun l hl t hlN ht => by rw [pow_one]; exact h1 l hl t hlN ht) c
  rwa [pow_one] at this

/-- If all generators of `GenBound q N` are trivial, the exponent of the class group is 1. -/
theorem exponent_eq_one_of_genBound {N : ℕ} (hg : GenBound q N)
    (h1 : ∀ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N → (l : ℤ) ∣ t ^ 2 - t - aOf q →
      classOf q l hl.ne_zero t = 1) :
    Monoid.exponent (ClassGroup (OK q)) = 1 := by
  have h := eq_one_of_genBound hg h1
  have : Subsingleton (ClassGroup (OK q)) := ⟨fun a b => by rw [h a, h b]⟩
  exact Monoid.exp_eq_one_iff.mpr this

/-- A split prime `l` with `4 l < q` gives a non-trivial class. -/
theorem classOf_ne_one {l : ℕ} (hl : l.Prime) {t : ℤ} (ht : (l : ℤ) ∣ t ^ 2 - t - aOf q)
    (hlt : 4 * l < q) : classOf q l hl.ne_zero t ≠ 1 := by
  rw [Ne, classOf_eq_one_iff]
  exact not_isPrincipal_idealI hl (by omega) ht (no_solution_of_lt hl hlt)

end

/-! ### Certificates -/

/-- A certificate for one integer `l ≥ 2`. -/
inductive Cert where
  /-- `l` is composite: `a ∣ l`, `1 < a < l`. -/
  | comp (a : ℕ)
  /-- `X^2 - X - a` has no root modulo `l` (checked for all residues). -/
  | inert
  /-- `4 l^n = x^2 + q y^2` with `l ∤ y`. -/
  | split (x y : ℕ)

/-- `r^2 - r + A ≢ 0 (mod l)` for all `r < b`. -/
def noRootBelow (A l : ℕ) : ℕ → Bool
  | 0 => true
  | r + 1 => ((r * r + (l - 1) * r + A) % l != 0) && noRootBelow A l r

/-- Check of a certificate for `l`, for the field `ℚ(√-q)` and the exponent `n`. -/
def Cert.ok (q n l : ℕ) : Cert → Bool
  | .comp a => decide (1 < a) && decide (a < l) && (l % a == 0)
  | .inert => noRootBelow ((q + 1) / 4) l l
  | .split x y => (4 * l ^ n == x ^ 2 + q * y ^ 2) && (y % l != 0)

/-- Check of a list of certificates for `l, l + 1, …`. -/
def certsOk (q n : ℕ) : ℕ → List Cert → Bool
  | _, [] => true
  | l, c :: cs => c.ok q n l && certsOk q n (l + 1) cs

lemma certsOk_exists (q n : ℕ) : ∀ (cs : List Cert) (l₀ : ℕ), certsOk q n l₀ cs = true →
    ∀ l, l₀ ≤ l → l < l₀ + cs.length → ∃ c : Cert, c.ok q n l = true := by
  intro cs
  induction cs with
  | nil => intro l₀ _ l h1 h2; simp at h2; omega
  | cons c cs ih =>
    intro l₀ h l h1 h2
    simp only [certsOk, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
    · exact ⟨c, h.1⟩
    · exact ih (l₀ + 1) h.2 l hlt (by simp at h2; omega)

lemma noRootBelow_spec (A l : ℕ) : ∀ b, noRootBelow A l b = true →
    ∀ r, r < b → (r * r + (l - 1) * r + A) % l ≠ 0 := by
  intro b
  induction b with
  | zero => intro _ r hr; omega
  | succ b ih =>
    intro h r hr
    simp only [noRootBelow, Bool.and_eq_true, bne_iff_ne, ne_eq] at h
    rcases Nat.eq_or_lt_of_le (Nat.lt_succ_iff.mp hr) with rfl | hlt
    · exact h.1
    · exact ih h.2 r hlt

/-- Soundness of the `inert` certificate. -/
lemma not_dvd_of_noRootBelow {A l : ℕ} (hl : 0 < l) (h : noRootBelow A l l = true) (t : ℤ) :
    ¬ (l : ℤ) ∣ t ^ 2 - t + A := by
  intro hd
  have hl' : (0 : ℤ) < l := by exact_mod_cast hl
  set r : ℕ := (t % l).toNat with hr
  have hr0 : 0 ≤ t % l := Int.emod_nonneg t hl'.ne'
  have hrl : t % l < l := Int.emod_lt_of_pos t hl'
  have hrt : (r : ℤ) = t % l := Int.toNat_of_nonneg hr0
  have hr_lt : r < l := by
    have : (r : ℤ) < l := by rw [hrt]; exact hrl
    exact_mod_cast this
  -- `t = r + l * k`
  have ht : t = r + l * (t / l) := by rw [hrt]; exact (Int.emod_add_mul_ediv t l).symm
  set k := t / (l : ℤ) with hk
  have hd2 : (l : ℤ) ∣ ((r * r + (l - 1) * r + A : ℕ) : ℤ) := by
    have e : ((r * r + (l - 1) * r + A : ℕ) : ℤ) =
        (t ^ 2 - t + A) + l * (r - 2 * r * k - l * k ^ 2 + k) := by
      rw [Nat.cast_add, Nat.cast_add, Nat.cast_mul, Nat.cast_mul, Nat.cast_sub hl]
      push_cast
      rw [ht]
      ring
    rw [e]
    exact dvd_add hd (dvd_mul_right _ _)
  have hd3 : l ∣ r * r + (l - 1) * r + A := by exact_mod_cast hd2
  exact noRootBelow_spec A l l h r hr_lt (Nat.mod_eq_zero_of_dvd hd3)

lemma aOf_eq_neg (q : ℕ) : aOf q = -(((q + 1) / 4 : ℕ) : ℤ) := by
  unfold aOf
  push_cast
  rfl

section

variable {q : ℕ} [hq : Fact q.Prime] [h4 : Fact (q % 4 = 3)]

/-- **Soundness of the certificates.** A valid list of certificates for `l = 2, …, L + 1` with
`q < (L + 2)^2` shows that `(l, ω - t)^n` is principal for every prime `l ≤ √q` and every root
`t`. -/
theorem isPrincipal_of_certs (n : ℕ) (cs : List Cert) (hok : certsOk q n 2 cs = true)
    (hlen : q < (cs.length + 2) * (cs.length + 2)) (l : ℕ) (hl : l.Prime) (t : ℤ)
    (hlN : l ≤ Nat.sqrt q) (ht : (l : ℤ) ∣ t ^ 2 - t - aOf q) :
    (idealI q l t ^ n).IsPrincipal := by
  have hll : l * l ≤ q := Nat.le_sqrt.mp hlN
  have hl2 := hl.two_le
  have hlt : l < 2 + cs.length := by
    by_contra hge
    have hge' : cs.length + 2 ≤ l := by omega
    have := Nat.mul_le_mul hge' hge'
    omega
  have hlq : l ≠ q := by
    rintro rfl
    nlinarith
  obtain ⟨c, hc⟩ := certsOk_exists q n cs 2 hok l hl2 hlt
  cases c with
  | comp a =>
    exfalso
    simp only [Cert.ok, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hc
    obtain ⟨⟨h1, h2⟩, h3⟩ := hc
    rcases (Nat.dvd_prime hl).mp (Nat.dvd_of_mod_eq_zero h3) with h | h <;> omega
  | inert =>
    exfalso
    simp only [Cert.ok] at hc
    rw [aOf_eq_neg, sub_neg_eq_add] at ht
    exact not_dvd_of_noRootBelow hl.pos hc t ht
  | split x y =>
    simp only [Cert.ok, Bool.and_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at hc
    obtain ⟨h1, h2⟩ := hc
    have hxy : 4 * (l : ℤ) ^ n = (x : ℤ) ^ 2 + q * (y : ℤ) ^ 2 := by exact_mod_cast h1
    have hy : ¬ (l : ℤ) ∣ (y : ℤ) := by
      rw [Int.natCast_dvd_natCast]
      exact fun hd => h2 (Nat.mod_eq_zero_of_dvd hd)
    exact idealI_pow_isPrincipal hl hlq ht n hxy hy

/-- **Exponent 7 from certificates.** Certificates for all `l ≤ √q` (exponent 7), one split
prime `l` with `4 l < q` (root `s + 1`), and `GenBound q √q` give exponent 7. -/
theorem exponent_eq_seven_of_certs (hg : GenBound q (Nat.sqrt q)) (cs : List Cert)
    (hok : certsOk q 7 2 cs = true) (hlen : q < (cs.length + 2) * (cs.length + 2))
    (l s : ℕ) (hl : l.Prime) (hlt : 4 * l < q) (hs : (s * (s + 1) + (q + 1) / 4) % l = 0) :
    Monoid.exponent (ClassGroup (OK q)) = 7 := by
  refine exponent_eq_seven_of_genBound hg ?_ ?_
  · intro l' hl' t hlN ht
    rw [classOf_pow_eq_one_iff]
    exact isPrincipal_of_certs 7 cs hok hlen l' hl' t hlN ht
  · have ht : (l : ℤ) ∣ ((s : ℤ) + 1) ^ 2 - ((s : ℤ) + 1) - aOf q := by
      rw [aOf_eq_neg, sub_neg_eq_add]
      have hd : (l : ℤ) ∣ ((s * (s + 1) + (q + 1) / 4 : ℕ) : ℤ) :=
        Int.natCast_dvd_natCast.mpr (Nat.dvd_of_mod_eq_zero hs)
      have e : ((s : ℤ) + 1) ^ 2 - ((s : ℤ) + 1) + (((q + 1) / 4 : ℕ) : ℤ) =
          ((s * (s + 1) + (q + 1) / 4 : ℕ) : ℤ) := by
        rw [Nat.cast_add, Nat.cast_mul, Nat.cast_add, Nat.cast_one]; ring
      rw [e]
      exact hd
    exact ⟨_, classOf_ne_one hl ht hlt⟩

/-- **Trivial class group from certificates.** Certificates for all `l ≤ √q` (exponent 1) and
`GenBound q √q` give exponent 1. -/
theorem exponent_eq_one_of_certs (hg : GenBound q (Nat.sqrt q)) (cs : List Cert)
    (hok : certsOk q 1 2 cs = true) (hlen : q < (cs.length + 2) * (cs.length + 2)) :
    Monoid.exponent (ClassGroup (OK q)) = 1 := by
  refine exponent_eq_one_of_genBound hg ?_
  intro l hl t hlN ht
  rw [classOf_eq_one_iff]
  have := isPrincipal_of_certs 1 cs hok hlen l hl t hlN ht
  rwa [pow_one] at this

end

/-- `IsExp7 q` from certificates. -/
theorem isExp7_of_certs {q : ℕ} (hq : q.Prime) (h4 : q % 4 = 3)
    (hg : @GenBound q ⟨hq⟩ ⟨h4⟩ (Nat.sqrt q)) (cs : List Cert)
    (hok : certsOk q 7 2 cs = true) (hlen : q < (cs.length + 2) * (cs.length + 2))
    (l s : ℕ) (hl : l.Prime) (hlt : 4 * l < q) (hs : (s * (s + 1) + (q + 1) / 4) % l = 0) :
    IsExp7 q :=
  ⟨hq, h4, @exponent_eq_seven_of_certs q ⟨hq⟩ ⟨h4⟩ hg cs hok hlen l s hl hlt hs⟩

/-- `¬ IsExp7 q` from exponent-one certificates. -/
theorem not_isExp7_of_certs {q : ℕ} (hq : q.Prime) (h4 : q % 4 = 3)
    (hg : @GenBound q ⟨hq⟩ ⟨h4⟩ (Nat.sqrt q)) (cs : List Cert)
    (hok : certsOk q 1 2 cs = true) (hlen : q < (cs.length + 2) * (cs.length + 2)) :
    ¬ IsExp7 q := by
  rintro ⟨hq', h4', hC⟩
  have : Fact q.Prime := ⟨hq⟩
  have : Fact (q % 4 = 3) := ⟨h4⟩
  have h1 : Monoid.exponent (ClassGroup (OK q)) = 1 := exponent_eq_one_of_certs hg cs hok hlen
  have h7 : Monoid.exponent (ClassGroup (OK q)) = 7 := hC
  omega

end Exp7
