import Exp7Lean.Final

/-!
Exponent 7: shared definitions for the class-group computations.

`GenBound q N` is a statement (a `Prop`), not a theorem: it says that the class group of `OK q` is
generated by the classes of the ideals `(l, ω - t)` with `l ≤ N` prime.
-/

namespace Exp7

open QuadraticAlgebra

open scoped nonZeroDivisors

section

variable {q : ℕ} [Fact q.Prime] [Fact (q % 4 = 3)]

omit [Fact q.Prime] [Fact (q % 4 = 3)] in
lemma idealI_ne_bot {l : ℕ} (hl : l ≠ 0) (t : ℤ) : idealI q l t ≠ ⊥ := by
  intro hbot
  have hmem : (l : OK q) ∈ idealI q l t := Ideal.subset_span (by simp)
  rw [hbot] at hmem
  have h0 : (l : OK q) = 0 := by simpa using hmem
  have := congrArg QuadraticAlgebra.re h0
  simp at this
  exact hl this

/-- The ideal class of `(l, ω - t)`. -/
noncomputable def classOf (q : ℕ) [Fact q.Prime] [Fact (q % 4 = 3)] (l : ℕ) (hl : l ≠ 0) (t : ℤ) :
    ClassGroup (OK q) :=
  ClassGroup.mk0 ⟨idealI q l t, mem_nonZeroDivisors_of_ne_zero (idealI_ne_bot hl t)⟩

/-- The class group of `OK q` is generated by the classes of the ideals `(l, ω - t)`, `l ≤ N` prime,
`t` a root of `X^2 - X - a` modulo `l`. -/
def GenBound (q : ℕ) [Fact q.Prime] [Fact (q % 4 = 3)] (N : ℕ) : Prop :=
  Subgroup.closure {c : ClassGroup (OK q) | ∃ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N ∧
    (l : ℤ) ∣ t ^ 2 - t - aOf q ∧ c = classOf q l hl.ne_zero t} = ⊤

end

end Exp7
