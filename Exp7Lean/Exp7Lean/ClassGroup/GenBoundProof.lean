import Exp7Lean.ClassGroup.Defs

/-!
Exponent 7: the class group of `OK q` is generated by the classes of the prime ideals
`(l, ω - t)` with `l ≤ √(q/3)`.

The proof is elementary (no Minkowski bound).

* `idealI_mul`: `(mn, ω - t) = (m, ω - t)(n, ω - t)` whenever `mn ∣ t^2 - t - a`.
* `idealI_norm`: `(N, ω - t) = (ω - t)` for `N = t^2 - t - a`, the norm of `ω - t`.
* Descent (`classOf_mem`): for a prime `l` with `q < 3 l^2`, move `t` modulo `l` so that
  `|2t - 1| ≤ l`. Then `4 (t^2 - t - a) = (2t - 1)^2 + q < 4 l^2`, so `t^2 - t - a = l c` with
  `c < l`, and `(l, ω - t)(c, ω - t) = (ω - t)` is principal.
* `isPrime_classify`: a nonzero prime ideal is principal or of the form `(l, ω - t)`.
-/

namespace Exp7

open QuadraticAlgebra

open scoped nonZeroDivisors

section

variable {q : ℕ} [hq : Fact q.Prime] [h4 : Fact (q % 4 = 3)]

/-- `GenBound` is monotone in the bound. -/
theorem GenBound.mono {N N' : ℕ} (h : GenBound q N) (hN : N ≤ N') : GenBound q N' := by
  unfold GenBound at *
  rw [eq_top_iff, ← h]
  apply Subgroup.closure_mono
  rintro c ⟨l, hl, t, hle, hdvd, rfl⟩
  exact ⟨l, hl, t, hle.trans hN, hdvd, rfl⟩

/-! ### The ideals `(m, ω - t)` -/

omit hq h4 in
lemma natCast_mem_idealI (m : ℕ) (t : ℤ) : (m : OK q) ∈ idealI q m t :=
  Ideal.subset_span (by simp)

omit hq h4 in
lemma omega_sub_mem_idealI (m : ℕ) (t : ℤ) : ω - (t : OK q) ∈ idealI q m t :=
  Ideal.subset_span (by simp)

omit hq h4 in
lemma idealI_le {m : ℕ} {t : ℤ} {J : Ideal (OK q)} (h1 : (m : OK q) ∈ J)
    (h2 : ω - (t : OK q) ∈ J) : idealI q m t ≤ J := by
  unfold idealI
  rw [Ideal.span_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact h1
  · exact h2

omit hq h4 in
lemma idealI_shift_le (m : ℕ) (t k : ℤ) : idealI q m (t + k * m) ≤ idealI q m t := by
  refine idealI_le (natCast_mem_idealI m t) ?_
  have e : ω - ((t + k * m : ℤ) : OK q) = (ω - (t : OK q)) - (k : OK q) * (m : OK q) := by
    push_cast; ring
  rw [e]
  exact Ideal.sub_mem _ (omega_sub_mem_idealI m t) (Ideal.mul_mem_left _ _ (natCast_mem_idealI m t))

omit hq h4 in
/-- The ideal `(m, ω - t)` depends only on `t` modulo `m`. -/
lemma idealI_shift (m : ℕ) (t k : ℤ) : idealI q m (t + k * m) = idealI q m t := by
  refine le_antisymm (idealI_shift_le m t k) ?_
  have := idealI_shift_le (q := q) m (t + k * m) (-k)
  have e : t + k * m + -k * m = t := by ring
  rwa [e] at this

omit hq h4 in
lemma idealI_one (t : ℤ) : idealI q 1 t = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  have := natCast_mem_idealI (q := q) 1 t
  simpa using this

omit hq h4 in
/-- `(ω - t) * (1 - ω - t) = t^2 - t - a`. -/
lemma omega_sub_mul (t : ℤ) :
    (ω - (t : OK q)) * (1 - ω - (t : OK q)) = ((t ^ 2 - t - aOf q : ℤ) : OK q) := by
  have h := algebraMap_norm_eq_mul_star (ω - (t : OK q))
  rw [star_omega_sub, norm_omega_sub] at h
  rw [← h]
  simp

omit hq h4 in
/-- `(N, ω - t) = (ω - t)` for `N = t^2 - t - a`, the norm of `ω - t`. -/
lemma idealI_norm {n : ℕ} {t : ℤ} (hn : (n : ℤ) = t ^ 2 - t - aOf q) :
    idealI q n t = Ideal.span {ω - (t : OK q)} := by
  apply le_antisymm
  · refine idealI_le ?_ (Ideal.subset_span rfl)
    rw [Ideal.mem_span_singleton]
    refine ⟨1 - ω - (t : OK q), ?_⟩
    rw [omega_sub_mul, ← hn]
    simp
  · rw [Ideal.span_singleton_le_iff_mem]
    exact omega_sub_mem_idealI n t

omit hq in
/-- `4 (t^2 - t - a) = (2t - 1)^2 + q`. -/
lemma four_mul_normT (t : ℤ) : 4 * (t ^ 2 - t - aOf q) = (2 * t - 1) ^ 2 + q := by
  linear_combination -four_aOf h4.out

lemma normT_pos (t : ℤ) : 0 < t ^ 2 - t - aOf q := by
  have h := four_mul_normT (q := q) t
  have hq0 : (0 : ℤ) < q := by exact_mod_cast hq.out.pos
  nlinarith [sq_nonneg (2 * t - 1)]

/-- If `mn ∣ t^2 - t - a` then `gcd(m, n, 1 - 2t) = 1`, because `q` is squarefree. -/
lemma exists_bezout {m n : ℕ} {t : ℤ} (h : ((m * n : ℕ) : ℤ) ∣ t ^ 2 - t - aOf q) :
    ∃ u v s : ℤ, u * m + v * n + s * (1 - 2 * t) = 1 := by
  set d : ℕ := Int.gcd (m : ℤ) (n : ℤ) with hd
  set g : ℕ := Int.gcd (d : ℤ) (1 - 2 * t) with hg
  have hgd : (g : ℤ) ∣ (d : ℤ) := Int.gcd_dvd_left _ _
  have hgm : (g : ℤ) ∣ (m : ℤ) := hgd.trans (Int.gcd_dvd_left _ _)
  have hgn : (g : ℤ) ∣ (n : ℤ) := hgd.trans (Int.gcd_dvd_right _ _)
  have hgt : (g : ℤ) ∣ 1 - 2 * t := Int.gcd_dvd_right _ _
  have hgg : (g : ℤ) * g ∣ (q : ℤ) := by
    have h1 : (g : ℤ) * g ∣ 4 * (t ^ 2 - t - aOf q) := by
      refine Dvd.dvd.mul_left (dvd_trans ?_ h) 4
      push_cast
      exact mul_dvd_mul hgm hgn
    have h2 : (g : ℤ) * g ∣ (1 - 2 * t) * (1 - 2 * t) := mul_dvd_mul hgt hgt
    have e : (q : ℤ) = 4 * (t ^ 2 - t - aOf q) - (1 - 2 * t) * (1 - 2 * t) := by
      linear_combination -four_mul_normT (q := q) t
    rw [e]
    exact dvd_sub h1 h2
  have hggN : g * g ∣ q := by exact_mod_cast hgg
  have hg1 : g = 1 := by
    rcases (Nat.dvd_prime hq.out).mp (Dvd.dvd.trans (dvd_mul_right g g) hggN) with h1 | h1
    · exact h1
    · exfalso
      rw [h1] at hggN
      have hle := Nat.le_of_dvd hq.out.pos hggN
      have := hq.out.one_lt
      nlinarith
  have b1 : (g : ℤ) = (d : ℤ) * Int.gcdA d (1 - 2 * t) + (1 - 2 * t) * Int.gcdB d (1 - 2 * t) :=
    Int.gcd_eq_gcd_ab _ _
  have b2 : (d : ℤ) = (m : ℤ) * Int.gcdA m n + (n : ℤ) * Int.gcdB m n := Int.gcd_eq_gcd_ab _ _
  rw [hg1] at b1
  refine ⟨Int.gcdA m n * Int.gcdA d (1 - 2 * t), Int.gcdB m n * Int.gcdA d (1 - 2 * t),
    Int.gcdB d (1 - 2 * t), ?_⟩
  push_cast at b1
  linear_combination -b1 - Int.gcdA d (1 - 2 * t) * b2

/-- `(mn, ω - t) = (m, ω - t)(n, ω - t)` whenever `mn ∣ t^2 - t - a`. -/
lemma idealI_mul {m n : ℕ} {t : ℤ} (h : ((m * n : ℕ) : ℤ) ∣ t ^ 2 - t - aOf q) :
    idealI q (m * n) t = idealI q m t * idealI q n t := by
  obtain ⟨u, v, s, hb⟩ := exists_bezout h
  obtain ⟨k, hk⟩ := h
  have hb' : ((u * m + v * n + s * (1 - 2 * t) : ℤ) : OK q) = 1 := by rw [hb]; simp
  have hk' := congrArg (Int.cast : ℤ → OK q) hk
  have hw : (ω - (t : OK q)) * (ω - (t : OK q)) =
      (1 - 2 * (t : OK q)) * (ω - (t : OK q)) - ((t : OK q) ^ 2 - (t : OK q) - (aOf q : OK q)) := by
    have h := omega_sub_mul (q := q) t
    push_cast at h
    linear_combination -h
  push_cast at hb' hk'
  apply le_antisymm
  · refine idealI_le ?_ ?_
    · push_cast
      exact Ideal.mul_mem_mul (natCast_mem_idealI m t) (natCast_mem_idealI n t)
    · have key : ω - (t : OK q) = (u : OK q) * ((m : OK q) * (ω - (t : OK q))) +
          (v : OK q) * ((ω - (t : OK q)) * (n : OK q)) +
          (s : OK q) * ((ω - (t : OK q)) * (ω - (t : OK q))) +
          (s : OK q) * (k : OK q) * ((m : OK q) * (n : OK q)) := by
        linear_combination (-(ω - (t : OK q))) * hb' - (s : OK q) * hw + (s : OK q) * hk'
      rw [key]
      refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_) ?_
      · exact Ideal.mul_mem_left _ _
          (Ideal.mul_mem_mul (natCast_mem_idealI m t) (omega_sub_mem_idealI n t))
      · exact Ideal.mul_mem_left _ _
          (Ideal.mul_mem_mul (omega_sub_mem_idealI m t) (natCast_mem_idealI n t))
      · exact Ideal.mul_mem_left _ _
          (Ideal.mul_mem_mul (omega_sub_mem_idealI m t) (omega_sub_mem_idealI n t))
      · exact Ideal.mul_mem_left _ _
          (Ideal.mul_mem_mul (natCast_mem_idealI m t) (natCast_mem_idealI n t))
  · rw [Ideal.mul_le]
    intro x hx y hy
    unfold idealI at hx hy
    rw [Ideal.mem_span_pair] at hx hy
    obtain ⟨a1, b1, rfl⟩ := hx
    obtain ⟨a2, b2, rfl⟩ := hy
    have e : (a1 * (m : OK q) + b1 * (ω - (t : OK q))) * (a2 * (n : OK q) + b2 * (ω - (t : OK q)))
        = a1 * a2 * ((m * n : ℕ) : OK q) + (a1 * (m : OK q) * b2 + b1 * a2 * (n : OK q) +
          b1 * b2 * (ω - (t : OK q))) * (ω - (t : OK q)) := by
      push_cast; ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (natCast_mem_idealI _ t))
      (Ideal.mul_mem_left _ _ (omega_sub_mem_idealI _ t))

/-! ### Classes -/

lemma classOf_congr {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) {t s : ℤ}
    (h : idealI q m t = idealI q n s) : classOf q m hm t = classOf q n hn s := by
  unfold classOf
  congr 1
  exact Subtype.ext h

lemma classOf_mul {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) {t : ℤ}
    (h : ((m * n : ℕ) : ℤ) ∣ t ^ 2 - t - aOf q) :
    classOf q (m * n) (mul_ne_zero hm hn) t = classOf q m hm t * classOf q n hn t := by
  unfold classOf
  rw [← map_mul]
  congr 1
  exact Subtype.ext (idealI_mul h)

lemma classOf_eq_one {m : ℕ} (hm : m ≠ 0) {t : ℤ} (h : (idealI q m t).IsPrincipal) :
    classOf q m hm t = 1 := by
  unfold classOf
  rw [ClassGroup.mk0_eq_one_iff]
  exact h

/-- Centre a residue: `t ≡ t' (mod l)` with `|2t' - 1| ≤ l`. -/
lemma exists_centered {l : ℤ} (hl : 0 < l) (t : ℤ) :
    ∃ t' k : ℤ, t = t' + k * l ∧ -l ≤ 2 * t' - 1 ∧ 2 * t' - 1 ≤ l := by
  have h0 := Int.emod_nonneg t hl.ne'
  have h1 := Int.emod_lt_of_pos t hl
  have h2 := Int.emod_add_mul_ediv t l
  by_cases h : 2 * (t % l) - 1 ≤ l
  · exact ⟨t % l, t / l, by linarith, by linarith, h⟩
  · exact ⟨t % l - l, t / l + 1, by linarith, by linarith, by linarith⟩

/-- The generating set of `GenBound q N`. -/
def genSet (q : ℕ) [Fact q.Prime] [Fact (q % 4 = 3)] (N : ℕ) : Set (ClassGroup (OK q)) :=
  {c : ClassGroup (OK q) | ∃ (l : ℕ) (hl : l.Prime) (t : ℤ), l ≤ N ∧
    (l : ℤ) ∣ t ^ 2 - t - aOf q ∧ c = classOf q l hl.ne_zero t}

/-- Descent: the class of every `(m, ω - t)` with `m ∣ t^2 - t - a` lies in the subgroup generated
by the classes of the `(l, ω - t)` with `l ≤ √(q/3)` prime. -/
lemma classOf_mem (m : ℕ) : ∀ (hm : m ≠ 0) (t : ℤ), (m : ℤ) ∣ t ^ 2 - t - aOf q →
    classOf q m hm t ∈ Subgroup.closure (genSet q (Nat.sqrt (q / 3))) := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
    intro hm t ht
    by_cases hm1 : m = 1
    · subst hm1
      rw [classOf_eq_one]
      · exact Subgroup.one_mem _
      · rw [idealI_one]
        exact ⟨⟨1, Ideal.span_singleton_one.symm⟩⟩
    have hl : (m.minFac).Prime := Nat.minFac_prime hm1
    obtain ⟨c, hc⟩ := Nat.minFac_dvd m
    set l := m.minFac with hldef
    have hc0 : c ≠ 0 := by
      rintro rfl
      exact hm (by simpa using hc)
    by_cases hc1 : c = 1
    · -- `m = l` is prime
      have hml : m = l := by rw [hc, hc1, mul_one]
      by_cases hle : l ≤ Nat.sqrt (q / 3)
      · refine Subgroup.subset_closure ⟨l, hl, t, hle, ?_, ?_⟩
        · rw [← hml]; exact ht
        · exact classOf_congr _ _ (by rw [← hml])
      · -- descent
        have hlt : q < 3 * l ^ 2 := by
          have := Nat.sqrt_lt'.mp (not_le.mp hle)
          omega
        have hlpos : (0 : ℤ) < (l : ℤ) := by exact_mod_cast hl.pos
        obtain ⟨t', k, htk, hlo, hhi⟩ := exists_centered hlpos t
        have ht' : (l : ℤ) ∣ t' ^ 2 - t' - aOf q := by
          have e : t' ^ 2 - t' - aOf q = (t ^ 2 - t - aOf q) - l * (k * (t + t' - 1)) := by
            rw [htk]; ring
          rw [e]
          exact dvd_sub (by rw [← hml]; exact ht) (dvd_mul_right _ _)
        obtain ⟨c', hc'⟩ := ht'
        have h4n := four_mul_normT (q := q) t'
        have hpos := normT_pos (q := q) t'
        have hltZ : (q : ℤ) < 3 * (l : ℤ) ^ 2 := by exact_mod_cast hlt
        have hsq : (2 * t' - 1) ^ 2 ≤ (l : ℤ) ^ 2 := by nlinarith
        have hc'pos : 0 < c' := by
          rw [hc'] at hpos
          by_contra hneg
          rw [not_lt] at hneg
          nlinarith
        have hc'lt : c' < l := by
          rw [hc'] at h4n
          nlinarith
        obtain ⟨c'', rfl⟩ : ∃ c'' : ℕ, c' = (c'' : ℤ) :=
          ⟨c'.toNat, (Int.toNat_of_nonneg hc'pos.le).symm⟩
        have hc''0 : c'' ≠ 0 := by
          rintro rfl
          simp at hc'pos
        have hc''lt : c'' < m := by
          rw [hml]
          exact_mod_cast hc'lt
        have hdvd : ((l * c'' : ℕ) : ℤ) ∣ t' ^ 2 - t' - aOf q := by
          rw [hc']; push_cast; exact dvd_rfl
        have hprod := classOf_mul hl.ne_zero hc''0 hdvd
        have hone : classOf q (l * c'') (mul_ne_zero hl.ne_zero hc''0) t' = 1 := by
          apply classOf_eq_one
          rw [idealI_norm (by rw [hc']; push_cast; rfl)]
          exact ⟨⟨_, rfl⟩⟩
        rw [hone] at hprod
        have hinv : classOf q l hl.ne_zero t' = (classOf q c'' hc''0 t')⁻¹ :=
          eq_inv_of_mul_eq_one_left hprod.symm
        have hmem := ih c'' hc''lt hc''0 t' ⟨l, by rw [hc']; ring⟩
        have hfin : classOf q m hm t = classOf q l hl.ne_zero t' := by
          apply classOf_congr
          rw [hml, htk, idealI_shift]
        rw [hfin, hinv]
        exact Subgroup.inv_mem _ hmem
    · -- `m = l * c` with `1 < c`
      have hlm : l < m := by
        have : 2 ≤ c := by omega
        have := hl.pos
        rw [hc]
        nlinarith
      have hcm : c < m := by
        have := hl.two_le
        rw [hc]
        have : 0 < c := Nat.pos_of_ne_zero hc0
        nlinarith
      have hdvd : ((l * c : ℕ) : ℤ) ∣ t ^ 2 - t - aOf q := by rw [← hc]; exact ht
      have hmul := classOf_mul hl.ne_zero hc0 hdvd
      have hfin : classOf q m hm t = classOf q (l * c) (mul_ne_zero hl.ne_zero hc0) t :=
        classOf_congr _ _ (by rw [← hc])
      rw [hfin, hmul]
      refine Subgroup.mul_mem _ (ih l hlm hl.ne_zero t ?_) (ih c hcm hc0 t ?_)
      · exact dvd_trans (by push_cast; exact dvd_mul_right _ _) hdvd
      · exact dvd_trans (by push_cast; exact dvd_mul_left _ _) hdvd

/-! ### Prime ideals of `OK q` -/

/-- A prime ideal `P ≠ ⊥` contains a rational prime `l`, and `P ∩ ℤ = lℤ`. -/
lemma exists_prime_mem (P : Ideal (OK q)) [hP : P.IsPrime] (hP0 : P ≠ ⊥) :
    ∃ l : ℕ, l.Prime ∧ (l : OK q) ∈ P ∧ ∀ x : ℤ, (x : OK q) ∈ P → (l : ℤ) ∣ x := by
  -- a nonzero natural number in `P`
  obtain ⟨α, hαP, hα0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP0
  have hnP : ((QuadraticAlgebra.norm α : ℤ) : OK q) ∈ P := by
    have h := algebraMap_norm_eq_mul_star α
    have e : ((QuadraticAlgebra.norm α : ℤ) : OK q) = α * star α := by rw [← h]; simp
    rw [e]
    exact Ideal.mul_mem_right _ _ hαP
  have hn0 : QuadraticAlgebra.norm α ≠ 0 := by
    intro h0
    have hndef : QuadraticAlgebra.norm α = α.re * α.re + 1 * α.re * α.im - aOf q * α.im * α.im :=
      QuadraticAlgebra.norm_def α
    have h4a := four_aOf h4.out
    have hq0 : (0 : ℤ) < q := by exact_mod_cast hq.out.pos
    have hn4 : (2 * α.re + α.im) ^ 2 + q * α.im ^ 2 = 0 := by
      linear_combination 4 * h0 - 4 * hndef + α.im ^ 2 * h4a
    have him : α.im = 0 := by
      by_contra him
      have : 0 < α.im ^ 2 := by positivity
      nlinarith [sq_nonneg (2 * α.re + α.im)]
    have hre : α.re = 0 := by
      rw [him] at hn4
      nlinarith [sq_nonneg (2 * α.re)]
    exact hα0 (by ext <;> simp [hre, him])
  have hnat : ∃ m : ℕ, m ≠ 0 ∧ (m : OK q) ∈ P := by
    refine ⟨(QuadraticAlgebra.norm α).natAbs, Int.natAbs_ne_zero.mpr hn0, ?_⟩
    rcases Int.natAbs_eq (QuadraticAlgebra.norm α) with h | h
    · have e : (((QuadraticAlgebra.norm α).natAbs : ℕ) : OK q) =
          ((QuadraticAlgebra.norm α : ℤ) : OK q) := by
        conv_rhs => rw [h]
        simp
      rw [e]; exact hnP
    · have e : (((QuadraticAlgebra.norm α).natAbs : ℕ) : OK q) =
          -((QuadraticAlgebra.norm α : ℤ) : OK q) := by
        conv_rhs => rw [h]
        simp
      rw [e]; exact Ideal.neg_mem_iff _ |>.mpr hnP
  -- a prime in `P`
  have hprime : ∀ m : ℕ, m ≠ 0 → (m : OK q) ∈ P → ∃ l : ℕ, l.Prime ∧ (l : OK q) ∈ P := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      intro hm hmP
      have hm1 : m ≠ 1 := by
        rintro rfl
        exact hP.ne_top (Ideal.eq_top_iff_one _ |>.mpr (by simpa using hmP))
      obtain ⟨c, hc⟩ := Nat.minFac_dvd m
      have hl := Nat.minFac_prime hm1
      have hmem : (m.minFac : OK q) * (c : OK q) ∈ P := by
        have : (m : OK q) = (m.minFac : OK q) * (c : OK q) := by
          conv_lhs => rw [hc]
          push_cast; rfl
        rwa [this] at hmP
      rcases hP.mem_or_mem hmem with h | h
      · exact ⟨_, hl, h⟩
      · have hc0 : c ≠ 0 := by
          rintro rfl
          exact hm (by simpa using hc)
        have hcm : c < m := by
          have := hl.two_le
          have : 0 < c := Nat.pos_of_ne_zero hc0
          conv_rhs => rw [hc]
          nlinarith
        exact ih c hcm hc0 h
  obtain ⟨m, hm0, hmP⟩ := hnat
  obtain ⟨l, hl, hlP⟩ := hprime m hm0 hmP
  refine ⟨l, hl, hlP, ?_⟩
  intro x hx
  by_contra hndvd
  have hcop : IsCoprime (l : ℤ) x :=
    (Nat.prime_iff_prime_int.mp hl).coprime_iff_not_dvd.mpr hndvd
  obtain ⟨u, v, huv⟩ := hcop
  have h1 : ((u * l + v * x : ℤ) : OK q) ∈ P := by
    push_cast
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hlP) (Ideal.mul_mem_left _ _ hx)
  rw [huv] at h1
  exact hP.ne_top (Ideal.eq_top_iff_one _ |>.mpr (by simpa using h1))

/-- Classification of the prime ideals of `OK q`: a nonzero prime ideal is either `(l)` for a
rational prime `l`, or `(l, ω - t)` for a rational prime `l` and a root `t` of `X^2 - X - a`
modulo `l`. -/
theorem isPrime_classify (P : Ideal (OK q)) [hP : P.IsPrime] (hP0 : P ≠ ⊥) :
    (∃ l : ℕ, l.Prime ∧ P = Ideal.span {(l : OK q)}) ∨
    ∃ (l : ℕ) (_ : l.Prime) (t : ℤ), (l : ℤ) ∣ t ^ 2 - t - aOf q ∧ P = idealI q l t := by
  obtain ⟨l, hl, hlP, hZ⟩ := exists_prime_mem P hP0
  have hlZ := Nat.prime_iff_prime_int.mp hl
  by_cases hroot : ∃ t : ℤ, (l : ℤ) ∣ t ^ 2 - t - aOf q
  · right
    obtain ⟨t, ht⟩ := hroot
    -- one of the two roots `t`, `1 - t` has `ω - root ∈ P`
    obtain ⟨s, hs, hsP⟩ : ∃ s : ℤ, (l : ℤ) ∣ s ^ 2 - s - aOf q ∧ ω - (s : OK q) ∈ P := by
      have hmem : (ω - (t : OK q)) * (ω - ((1 - t : ℤ) : OK q)) ∈ P := by
        obtain ⟨k, hk⟩ := ht
        have e : (ω - (t : OK q)) * (ω - ((1 - t : ℤ) : OK q)) = -((l : OK q) * (k : OK q)) := by
          have hw := omega_sub_mul (q := q) t
          rw [hk] at hw
          push_cast at hw ⊢
          linear_combination -hw
        rw [e]
        exact Ideal.neg_mem_iff _ |>.mpr (Ideal.mul_mem_right _ _ hlP)
      rcases hP.mem_or_mem hmem with h | h
      · exact ⟨t, ht, h⟩
      · refine ⟨1 - t, ?_, h⟩
        have e : (1 - t) ^ 2 - (1 - t) - aOf q = t ^ 2 - t - aOf q := by ring
        rw [e]; exact ht
    refine ⟨l, hl, s, hs, le_antisymm ?_ (idealI_le hlP hsP)⟩
    intro α hα
    have hdec : α = ((α.re + α.im * s : ℤ) : OK q) + (α.im : OK q) * (ω - (s : OK q)) := by
      ext <;> simp
    have hint : ((α.re + α.im * s : ℤ) : OK q) ∈ P := by
      have e : ((α.re + α.im * s : ℤ) : OK q) = α - (α.im : OK q) * (ω - (s : OK q)) := by
        rw [eq_sub_iff_add_eq]; exact hdec.symm
      rw [e]
      exact Ideal.sub_mem _ hα (Ideal.mul_mem_left _ _ hsP)
    obtain ⟨k, hk⟩ := hZ _ hint
    rw [hdec, hk]
    push_cast
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (natCast_mem_idealI l s))
      (Ideal.mul_mem_left _ _ (omega_sub_mem_idealI l s))
  · left
    refine ⟨l, hl, le_antisymm ?_ ((Ideal.span_singleton_le_iff_mem _).mpr hlP)⟩
    intro α hα
    have hnP : ((QuadraticAlgebra.norm α : ℤ) : OK q) ∈ P := by
      have h := algebraMap_norm_eq_mul_star α
      have e : ((QuadraticAlgebra.norm α : ℤ) : OK q) = α * star α := by rw [← h]; simp
      rw [e]
      exact Ideal.mul_mem_right _ _ hα
    have hdn := hZ _ hnP
    have hndef : QuadraticAlgebra.norm α = α.re * α.re + 1 * α.re * α.im - aOf q * α.im * α.im :=
      QuadraticAlgebra.norm_def α
    rw [hndef] at hdn
    have hy : (l : ℤ) ∣ α.im := by
      by_contra hndvd
      obtain ⟨u, v, huv⟩ := hlZ.coprime_iff_not_dvd.mpr hndvd
      apply hroot
      refine ⟨-(α.re * v), ?_⟩
      obtain ⟨k, hk⟩ := hdn
      refine ⟨v ^ 2 * k + u * (α.re * v - aOf q * (1 + v * α.im)), ?_⟩
      have hu : u * (l : ℤ) = 1 - v * α.im := by linarith
      linear_combination v ^ 2 * hk - (α.re * v - aOf q * (1 + v * α.im)) * hu
    have hx : (l : ℤ) ∣ α.re := by
      obtain ⟨y', hy'⟩ := hy
      have h2 : (l : ℤ) ∣ α.re * α.re := by
        have e : α.re * α.re = (α.re * α.re + 1 * α.re * α.im - aOf q * α.im * α.im) -
            l * (α.re * y' - aOf q * y' * α.im) := by rw [hy']; ring
        rw [e]
        exact dvd_sub hdn (dvd_mul_right _ _)
      rcases hlZ.dvd_or_dvd h2 with h | h <;> exact h
    obtain ⟨x', hx'⟩ := hx
    obtain ⟨y', hy'⟩ := hy
    rw [Ideal.mem_span_singleton]
    refine ⟨⟨x', y'⟩, ?_⟩
    ext <;> simp [hx', hy']

/-! ### The generation theorem -/

/-- Every ideal class lies in the subgroup generated by the classes of the `(l, ω - t)` with
`l ≤ √(q/3)` prime. -/
lemma mk0_mem (I : Ideal (OK q)) : ∀ hI : I ∈ (Ideal (OK q))⁰,
    ClassGroup.mk0 ⟨I, hI⟩ ∈ Subgroup.closure (genSet q (Nat.sqrt (q / 3))) := by
  induction I using UniqueFactorizationMonoid.induction_on_prime with
  | h₁ =>
    intro hI
    exact absurd rfl (nonZeroDivisors.ne_zero hI)
  | h₂ I hI =>
    intro hI'
    have htop : I = ⊤ := Ideal.isUnit_iff.mp hI
    have : ClassGroup.mk0 ⟨I, hI'⟩ = 1 := by
      rw [ClassGroup.mk0_eq_one_iff, htop]
      exact ⟨⟨1, Ideal.span_singleton_one.symm⟩⟩
    rw [this]
    exact Subgroup.one_mem _
  | h₃ J P hJ0 hPprime ih =>
    intro hPJ
    have hP0 : P ≠ ⊥ := hPprime.ne_zero
    have hPm : P ∈ (Ideal (OK q))⁰ := mem_nonZeroDivisors_of_ne_zero hP0
    have hJm : J ∈ (Ideal (OK q))⁰ := mem_nonZeroDivisors_of_ne_zero hJ0
    have e : ClassGroup.mk0 ⟨P * J, hPJ⟩ = ClassGroup.mk0 ⟨P, hPm⟩ * ClassGroup.mk0 ⟨J, hJm⟩ := by
      rw [← map_mul]
      rfl
    rw [e]
    refine Subgroup.mul_mem _ ?_ (ih hJm)
    have hPp : P.IsPrime := Ideal.isPrime_of_prime hPprime
    rcases isPrime_classify P hP0 with ⟨l, -, hl⟩ | ⟨l, hl, t, ht, hPl⟩
    · have : ClassGroup.mk0 ⟨P, hPm⟩ = 1 := by
        rw [ClassGroup.mk0_eq_one_iff, hl]
        exact ⟨⟨_, rfl⟩⟩
      rw [this]
      exact Subgroup.one_mem _
    · have : ClassGroup.mk0 ⟨P, hPm⟩ = classOf q l hl.ne_zero t := by
        unfold classOf
        congr 1
        exact Subtype.ext hPl
      rw [this]
      exact classOf_mem l hl.ne_zero t ht

/-- The class group of `OK q` is generated by the classes of the prime ideals `(l, ω - t)` with
`l ≤ √(q/3)`. -/
theorem genBound_sqrt_div_three (q : ℕ) [Fact q.Prime] [Fact (q % 4 = 3)] :
    GenBound q (Nat.sqrt (q / 3)) := by
  unfold GenBound
  rw [eq_top_iff]
  intro c _
  obtain ⟨⟨I, hI⟩, rfl⟩ := ClassGroup.mk0_surjective c
  exact mk0_mem I hI

/-- The class group of `OK q` is generated by the classes of the prime ideals `(l, ω - t)` with
`l ≤ √q`. -/
theorem genBound_sqrt (q : ℕ) [Fact q.Prime] [Fact (q % 4 = 3)] : GenBound q (Nat.sqrt q) :=
  (genBound_sqrt_div_three q).mono (Nat.sqrt_le_sqrt (Nat.div_le_self q 3))

end

