import Exp7Lean.ClassGroup.KnownData

/-!
Exponent 7: the 33 known primes have class group of exponent 7, and the class-number-one primes
do not, given `GenBound q √q` (the class group is generated by the primes above `l ≤ √q`).

`GenBound` is a hypothesis here; it is proved elsewhere.
-/

namespace Exp7

open KnownData

/-- Each of the 33 primes of `known` has class group of exponent 7, given that the class group is
generated by the prime ideals above the primes `l ≤ √q`. -/
theorem isExp7_of_known (q : ℕ) (hk : q ∈ known) (hq : q.Prime) (h4 : q % 4 = 3)
    (hg : @GenBound q ⟨hq⟩ ⟨h4⟩ (Nat.sqrt q)) : IsExp7 q := by
  simp only [known, List.mem_cons, List.not_mem_nil, or_false] at hk
  rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact isExp7_71 hq h4 hg
  · exact isExp7_151 hq h4 hg
  · exact isExp7_223 hq h4 hg
  · exact isExp7_251 hq h4 hg
  · exact isExp7_463 hq h4 hg
  · exact isExp7_467 hq h4 hg
  · exact isExp7_487 hq h4 hg
  · exact isExp7_587 hq h4 hg
  · exact isExp7_811 hq h4 hg
  · exact isExp7_827 hq h4 hg
  · exact isExp7_859 hq h4 hg
  · exact isExp7_1163 hq h4 hg
  · exact isExp7_1171 hq h4 hg
  · exact isExp7_1483 hq h4 hg
  · exact isExp7_1523 hq h4 hg
  · exact isExp7_1627 hq h4 hg
  · exact isExp7_1787 hq h4 hg
  · exact isExp7_1987 hq h4 hg
  · exact isExp7_2011 hq h4 hg
  · exact isExp7_2083 hq h4 hg
  · exact isExp7_2179 hq h4 hg
  · exact isExp7_2251 hq h4 hg
  · exact isExp7_2467 hq h4 hg
  · exact isExp7_2707 hq h4 hg
  · exact isExp7_3019 hq h4 hg
  · exact isExp7_3067 hq h4 hg
  · exact isExp7_3187 hq h4 hg
  · exact isExp7_3907 hq h4 hg
  · exact isExp7_4603 hq h4 hg
  · exact isExp7_5107 hq h4 hg
  · exact isExp7_5923 hq h4 hg
  · exact isExp7_63499 hq h4 hg
  · exact isExp7_118843 hq h4 hg

/-- The class-number-one primes `q ≡ 3 (mod 4)` do not have class group of exponent 7 (it is
trivial), given that the class group is generated by the prime ideals above the primes `l ≤ √q`. -/
theorem not_isExp7_of_classNumberOne (q : ℕ) (hq1 : q ∈ [3, 7, 11, 19, 43, 67, 163])
    (hq : q.Prime) (h4 : q % 4 = 3) (hg : @GenBound q ⟨hq⟩ ⟨h4⟩ (Nat.sqrt q)) : ¬ IsExp7 q := by
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq1
  rcases hq1 with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact not_isExp7_3 hq h4 hg
  · exact not_isExp7_7 hq h4 hg
  · exact not_isExp7_11 hq h4 hg
  · exact not_isExp7_19 hq h4 hg
  · exact not_isExp7_43 hq h4 hg
  · exact not_isExp7_67 hq h4 hg
  · exact not_isExp7_163 hq h4 hg

end Exp7
