import Exp7Lean.Final4
import Exp7Lean.Cond.RobustRows

/-!
Exponent 7: the lower bounds for `q` given by the 26 threshold rows, and the primes `p` that
cannot be the least split prime.

Let `q ≡ 3 (mod 4)` be a prime and suppose no prime below `p` splits in `ℚ(√-q)` (for instance,
`p` is the least split prime).  Under GRH:

* `robustRow_lt`  : `r.Q < q` for every threshold row `r` with `r.T ≤ p`, if `r.X < q`;
* `QloRobust_lt`  : `QloRobust p < q` if `q > 8209` (`QloRobust p` = max of `Q` over these rows);
* `QloR_le`       : `QloR p ≤ q` if `q ≥ QLOW`, where `QloR p = max (Qlo p) (QloRobust p)`.

`excludedPrimes` is the list of the NEX primes `701 ≤ p ≤ 4297` with `4 p^7 < QloR p`
(`mem_excludedPrimes`, a kernel computation): the primes `3203, 3209, 3217, 3221` and all primes
`3251 ≤ p ≤ 4297`.  For these the norm equation `4 p^7 = x² + q y²`, `y ≥ 1` (which gives
`q ≤ 4 p^7`) is impossible when `p` is the least split prime (`excluded_lt`,
`excluded_no_solution`).

The explicit formula is instantiated with `EF.explicitFormulaBound`; GRH for the characters of
prime conductor stays a hypothesis.  Generated by `Exp7Lean/Cond/gen_bounds.py`.
-/

namespace Exp7

open Exp7.Num

/-- The maximum of `Q` over the threshold rows with `T ≤ p` (`0` if there is none). -/
def QloRobust (p : ℕ) : ℕ :=
  (robustRows.filter (fun r => r.T ≤ p)).foldr (fun r acc => max r.Q acc) 0

/-- The lower bound for `q` when no prime below `p` splits: the maximum of `QLOW`, of `Q` over the
ladder rows with `X ≤ p` (together: `Qlo p`), and of `Q` over the threshold rows with `T ≤ p`. -/
def QloR (p : ℕ) : ℕ := max (Qlo p) (QloRobust p)

theorem Qlo_le_QloR (p : ℕ) : Qlo p ≤ QloR p := le_max_left _ _

theorem robustRows_X_le : ∀ r ∈ robustRows, r.X ≤ 8209 := by decide +kernel

/-- One threshold row, with the explicit formula proved. -/
theorem robustRow_lt (hGRH : GRHPrimeConductor) {r : RRow} (hr : r ∈ robustRows) {q : ℕ}
    (hq : q.Prime) (h4 : q % 4 = 3) (hXq : r.X < q)
    (hin : ∀ l, l.Prime → l < r.T → ¬ Splits q l) : r.Q < q :=
  lt_of_robustOK EF.explicitFormulaBound hGRH (robustRows_ok r hr) hq h4 hXq hin

/-- If no prime below `p` splits in `ℚ(√-q)`, then `q` exceeds every threshold row with
`T ≤ p`. -/
theorem QloRobust_lt (hGRH : GRHPrimeConductor) {q p : ℕ} (hq : q.Prime) (h4 : q % 4 = 3)
    (hXq : 8209 < q) (hin : ∀ l, l.Prime → l < p → ¬ Splits q l) : QloRobust p < q := by
  unfold QloRobust
  have key : ∀ L : List RRow, (∀ r ∈ L, r.Q < q) →
      L.foldr (fun r acc => max r.Q acc) 0 < q := by
    intro L
    induction L with
    | nil => intro _; simpa using hq.pos
    | cons r t ih =>
      intro h
      simp only [List.foldr_cons]
      exact max_lt (h r (by simp)) (ih (fun r' hr' => h r' (by simp [hr'])))
  apply key
  intro r hr
  rw [List.mem_filter] at hr
  have hT : r.T ≤ p := by simpa using hr.2
  exact robustRow_lt hGRH hr.1 hq h4 (lt_of_le_of_lt (robustRows_X_le r hr.1) hXq)
    (fun l hl hlt => hin l hl (lt_of_lt_of_le hlt hT))

/-- If no prime below `p` splits in `ℚ(√-q)`, then `q` exceeds every ladder row with `X ≤ p`
(the bound `Qlo p` of the main search, here with all its inputs proved except GRH). -/
theorem Qlo_le_of_inert (hGRH : GRHPrimeConductor) {q p : ℕ} (hq : q.Prime) (h4 : q % 4 = 3)
    (hlow : QLOW ≤ q) (hin : ∀ l, l.Prime → l < p → ¬ Splits q l) : Qlo p ≤ q := by
  refine Qlo_le hlow (fun r hr hXp => ?_)
  by_contra hcon
  have hqQ : q ≤ r.Q := (not_le.mp hcon).le
  have hXq : r.X < q := by
    have := allRows_X_le r hr
    have : 6362 < QLOW := by norm_num [QLOW]
    omega
  obtain ⟨l, hl, hlX, hs⟩ := cert_of_margins EF.explicitFormulaBound hGRH allRows
    rowMargins_allRows r hr q hq h4 hXq hqQ
  exact hin l hl (lt_of_lt_of_le hlX hXp) hs

/-- **The strengthened lower bound.** For a prime `q ≡ 3 (mod 4)`, `q ≥ QLOW`, without split
prime below `p` (e.g. `p` the least split prime), GRH gives `QloR p ≤ q`. -/
theorem QloR_le (hGRH : GRHPrimeConductor) {q p : ℕ} (hq : q.Prime) (h4 : q % 4 = 3)
    (hlow : QLOW ≤ q) (hin : ∀ l, l.Prime → l < p → ¬ Splits q l) : QloR p ≤ q := by
  have h8209 : 8209 < QLOW := by norm_num [QLOW]
  exact max_le (Qlo_le_of_inert hGRH hq h4 hlow hin)
    (QloRobust_lt hGRH hq h4 (lt_of_lt_of_le h8209 hlow) hin).le

/-- The hypotheses of the searches (`q ≡ 3 (mod 8)` and Jacobi symbols `-1` at the odd primes
below `p`) say that no prime below `p` splits. -/
theorem not_splits_of_jacobi {q p : ℕ} (h8 : q % 8 = 3)
    (hj : ∀ l, l.Prime → 3 ≤ l → l < p → jacobiSym (-(q : ℤ)) l = -1) :
    ∀ l, l.Prime → l < p → ¬ Splits q l := by
  intro l hl hlp hs
  by_cases h2 : l = 2
  · subst h2
    have : q % 8 = 7 := by simpa [Splits] using hs
    omega
  · have h3 : 3 ≤ l := by
      have := hl.two_le
      omega
    have h1 : jacobiSym (-(q : ℤ)) l = 1 := by simpa [Splits, h2] using hs
    rw [hj l hl h3 hlp] at h1
    exact absurd h1 (by decide)

/-- `QloR_le` with the hypotheses in the form used by the searches. -/
theorem QloR_le_of_jacobi (hGRH : GRHPrimeConductor) {q p : ℕ} (hq : q.Prime) (h8 : q % 8 = 3)
    (hlow : QLOW ≤ q)
    (hj : ∀ l, l.Prime → 3 ≤ l → l < p → jacobiSym (-(q : ℤ)) l = -1) : QloR p ≤ q :=
  QloR_le hGRH hq (by omega) hlow (not_splits_of_jacobi h8 hj)

/-! ### The primes that cannot be the least split prime -/

/-- The NEX primes `701 ≤ p ≤ 4297` with `4 p^7 < QloR p`. -/
def excludedPrimes : List ℕ := [
EXLIST]

/-- Kernel-friendly form of `p.Prime ∧ 701 ≤ p ∧ p ≤ 4297 ∧ 4 p^7 < QloR p`. -/
def exclB (p : ℕ) : Bool :=
  Nat.ble 701 p && (Nat.ble p 4297 && (isPrimeB p && decide (4 * p ^ 7 < QloR p)))

theorem exclB_iff (p : ℕ) :
    exclB p = true ↔ p.Prime ∧ 701 ≤ p ∧ p ≤ 4297 ∧ 4 * p ^ 7 < QloR p := by
  unfold exclB
  simp only [Bool.and_eq_true, Nat.ble_eq, isPrimeB_iff, decide_eq_true_eq]
  tauto

set_option maxRecDepth 100000 in
/-- Kernel computation: every listed prime passes the test. -/
theorem excludedPrimes_check : listAll exclB excludedPrimes = true := by decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel computation: every `p < 4298` passing the test is listed. -/
theorem excludedPrimes_complete_check :
    allBelow (fun p => !(exclB p) || decide (p ∈ excludedPrimes)) 4298 = true := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel computation: for the listed primes the threshold rows alone give
`4 p^7 < QloRobust p`. -/
theorem excludedPrimes_robust_check :
    listAll (fun p => decide (4 * p ^ 7 < QloRobust p)) excludedPrimes = true := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel computation: the list consists of `3203, 3209, 3217, 3221` and the primes in
`[3251, 4297]`. -/
theorem excludedPrimes_shape_check :
    allBelow (fun p => Bool.beq (decide (p ∈ excludedPrimes))
      (isPrimeB p && (Nat.ble 3251 p || (Nat.ble 3203 p && Nat.ble p 3221)))) 4298 = true := by
  decide +kernel

/-- **The list is exact**: `p ∈ excludedPrimes` iff `p` is a prime with `701 ≤ p ≤ 4297` and
`4 p^7 < QloR p`. -/
theorem mem_excludedPrimes (p : ℕ) :
    p ∈ excludedPrimes ↔ p.Prime ∧ 701 ≤ p ∧ p ≤ 4297 ∧ 4 * p ^ 7 < QloR p := by
  rw [← exclB_iff]
  constructor
  · intro h
    exact (listAll_iff _ _).mp excludedPrimes_check p h
  · intro h
    have hp : p < 4298 := by
      have := ((exclB_iff p).mp h).2.2.1
      omega
    have hc := (allBelow_iff _ _).mp excludedPrimes_complete_check p hp
    rw [h] at hc
    simpa using hc

/-- For the listed primes the threshold rows alone give the bound. -/
theorem excludedPrimes_lt_QloRobust : ∀ p ∈ excludedPrimes, 4 * p ^ 7 < QloRobust p := by
  intro p hp
  exact of_decide_eq_true ((listAll_iff _ _).mp excludedPrimes_robust_check p hp)

/-- Every prime `3229 < p ≤ 4297` is excluded. -/
theorem mem_excludedPrimes_of_gt {p : ℕ} (hp : p.Prime) (h1 : 3229 < p) (h2 : p ≤ 4297) :
    p ∈ excludedPrimes := by
  have hc := (allBelow_iff _ _).mp excludedPrimes_shape_check p (by omega)
  have hpr : isPrimeB p = true := (isPrimeB_iff p).mpr hp
  have h3251 : 3251 ≤ p := by
    by_contra hlt
    have hlt' : p < 3251 := not_le.mp hlt
    have : ¬ p.Prime := by
      interval_cases p <;> norm_num
    exact this hp
  have h3 : Nat.ble 3251 p = true := Nat.ble_eq.mpr h3251
  rw [hpr, h3] at hc
  cases hd : decide (p ∈ excludedPrimes) with
  | true => exact of_decide_eq_true hd
  | false =>
    rw [hd] at hc
    exact absurd (show false = true from hc) Bool.false_ne_true

/-- The largest prime `p ≤ 4297` that is not excluded is `3229`. -/
theorem le_3229_of_not_mem {p : ℕ} (hp : p.Prime) (h2 : p ≤ 4297) (hn : p ∉ excludedPrimes) :
    p ≤ 3229 := by
  by_contra h
  exact hn (mem_excludedPrimes_of_gt hp (not_le.mp h) h2)

/-- **Exclusion.** Under GRH, if `q ≡ 3 (mod 4)` is a prime, `q > 8209`, and no prime below
`p ∈ excludedPrimes` splits in `ℚ(√-q)`, then `q > 4 p^7`. -/
theorem excluded_lt (hGRH : GRHPrimeConductor) : ∀ p ∈ excludedPrimes, ∀ q : ℕ, q.Prime →
    q % 4 = 3 → 8209 < q → (∀ l, l.Prime → l < p → ¬ Splits q l) → 4 * p ^ 7 < q := by
  intro p hp q hq h4 hXq hin
  exact lt_trans (excludedPrimes_lt_QloRobust p hp) (QloRobust_lt hGRH hq h4 hXq hin)

/-- **Exclusion, norm-equation form.** Under GRH, a prime `p ∈ excludedPrimes` is not the least
split prime of any prime `q ≡ 3 (mod 4)`, `q > 8209`, for which the norm equation
`4 p^7 = x² + q y²` has a solution with `y ≥ 1`.  (No assumption that `p` itself splits is
needed.) -/
theorem excluded_no_solution (hGRH : GRHPrimeConductor) : ∀ p ∈ excludedPrimes, ∀ q : ℕ,
    q.Prime → q % 4 = 3 → 8209 < q → (∀ l, l.Prime → l < p → ¬ Splits q l) →
    ¬ ∃ x y : ℕ, 1 ≤ y ∧ 4 * p ^ 7 = x ^ 2 + q * y ^ 2 := by
  intro p hp q hq h4 hXq hin ⟨x, y, hy, he⟩
  have hlt := excluded_lt hGRH p hp q hq h4 hXq hin
  have h1 : q ≤ q * y ^ 2 := Nat.le_mul_of_pos_right q (by positivity)
  omega

/-- **Exclusion, in the form of the main search** (`SearchHigh`): for `p ∈ excludedPrimes` and a
prime `q > 8209` there is nothing to search. -/
theorem excluded_search (hGRH : GRHPrimeConductor) : ∀ p ∈ excludedPrimes, ∀ x y q : ℕ,
    1 ≤ y → 4 * p ^ 7 = x ^ 2 + q * y ^ 2 → q.Prime → 8209 < q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < p → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro p hp x y q hy he hq hXq h8 hj
  exact excluded_no_solution hGRH p hp q hq (by omega) hXq (not_splits_of_jacobi h8 hj)
    ⟨x, y, hy, he⟩

end Exp7

