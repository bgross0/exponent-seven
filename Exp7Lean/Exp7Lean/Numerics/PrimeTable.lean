import Exp7Lean.Numerics.Checks
import Exp7Lean.Numerics.PrimeList

/-!
# A certified table of `log p` and `√p` for the primes below 6400

`primeTable6400` is a literal list of triples `(p, L, S)`, one for each of the 834 primes
`p < 6400` (decreasing), with

    L ≤ 10^20 · log p ≤ L + 16,        S ≤ 10^20 · √p ≤ S + 1.

The table is checked against the verified evaluators by one kernel computation
(`primeTable6400_check`); afterwards a sum over primes can be evaluated by folding over the
literal, with no logarithm, square root or primality test recomputed.
-/

namespace Exp7.Num

open Real

/-- Kernel-friendly universal check over a list. -/
def listAll {α : Type} (f : α → Bool) (L : List α) : Bool :=
  List.rec (motive := fun _ => Bool) true (fun e _ ih => Bool.rec false ih (f e)) L

theorem listAll_iff {α : Type} (f : α → Bool) (L : List α) :
    listAll f L = true ↔ ∀ e ∈ L, f e = true := by
  induction L with
  | nil => simp [listAll]
  | cons a L ih =>
    have e : listAll f (a :: L) = Bool.rec false (listAll f L) (f a) := rfl
    rw [e]
    cases hf : f a with
    | false => simp [hf]
    | true => simp [hf, ih]

set_option maxRecDepth 100000 in
