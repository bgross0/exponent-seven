set_option maxRecDepth 100000 in
/-- The first components are exactly the certified prime list. -/
theorem primeTable6400_primes : primeTable6400.map Prod.fst = primeList6400 := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel computation: every entry agrees with the verified evaluators. -/
theorem primeTable6400_check :
    listAll (fun e => Nat.beq e.2.1 (logLo P20 e.1) && Nat.beq e.2.2 (sqrtLo20 e.1))
      primeTable6400 = true := by
  decide +kernel

/-- Every table entry is a prime below `6400` together with enclosures of `log p` and `√p`
(scale `10^20`, widths `16` and `1`). -/
theorem primeTable6400_spec {p L S : ℕ} (h : (p, L, S) ∈ primeTable6400) :
    p.Prime ∧ p < 6400 ∧
      (L : ℝ) ≤ 10 ^ 20 * log p ∧ 10 ^ 20 * log p ≤ (L : ℝ) + 16 ∧
      (S : ℝ) ≤ 10 ^ 20 * √(p : ℝ) ∧ 10 ^ 20 * √(p : ℝ) ≤ (S : ℝ) + 1 := by
  have hp : p ∈ primeList6400 := by
    rw [← primeTable6400_primes]
    exact List.mem_map.mpr ⟨(p, L, S), h, rfl⟩
  obtain ⟨hprime, hlt⟩ := (mem_primeList6400 p).mp hp
  have hc := (listAll_iff _ _).mp primeTable6400_check (p, L, S) h
  rw [Bool.and_eq_true] at hc
  have hL : L = logLo P20 p := Nat.eq_of_beq_eq_true hc.1
  have hS : S = sqrtLo20 p := Nat.eq_of_beq_eq_true hc.2
  have h2 : 2 ≤ p := hprime.two_le
  have hl := log_mem_6400 h2 hlt.le
  have hs := sqrt_mem_6400 h2 hlt.le
  rw [← hL] at hl
  rw [← hS] at hs
  refine ⟨hprime, hlt, ?_, ?_, ?_, ?_⟩
  · have := hl.1; rw [div_le_iff₀ (by positivity)] at this; linarith
  · have := hl.2; rw [le_div_iff₀ (by positivity)] at this; linarith
  · have := hs.1; rw [div_le_iff₀ (by positivity)] at this; linarith
  · have := hs.2; rw [le_div_iff₀ (by positivity)] at this; linarith

/-- Completeness: every prime below `6400` has an entry. -/
theorem primeTable6400_complete {p : ℕ} (hp : p.Prime) (hlt : p < 6400) :
    ∃ L S, (p, L, S) ∈ primeTable6400 := by
  have h : p ∈ primeTable6400.map Prod.fst := by
    rw [primeTable6400_primes]; exact (mem_primeList6400 p).mpr ⟨hp, hlt⟩
  obtain ⟨⟨q, L, S⟩, hmem, hq⟩ := List.mem_map.mp h
  simp only at hq
  subst hq
  exact ⟨L, S, hmem⟩

theorem primeTable6400_nodup : (primeTable6400.map Prod.fst).Nodup := by
  rw [primeTable6400_primes]; exact primeList6400_nodup

end Exp7.Num
