/-- The instance `p = 1487` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1487 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1487 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1487 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1487 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 1487 := by decide +kernel
  exact Exp7.Sieve.P1487.prime x y q hy hS (hQ.trans hq) h8 hj

