/-- The instance `p = 1499` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1499 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1499 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1499 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1499 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 1499 := by decide +kernel
  exact Exp7.Sieve.P1499.prime x y q hy hS (hQ.trans hq) h8 hj

#print axioms Exp7.search_1499
