/-- The instance `p = 1601` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1601 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1601 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1601 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1601 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
