/-- The instance `p = 1613` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1613 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1613 ^ 7 = x ^ 2 + q * y ^ 2 →
