/-- The instance `p = 1621` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1621 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1621 ^ 7 = x ^ 2 + q * y ^ 2 →
