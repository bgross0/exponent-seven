theorem Exp7.search_1747 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1747 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1747 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1747 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
