/-- The instance `p = 1789` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1789 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1789 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1789 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1789 → jacobiSym (-(q : ℤ)) l = -1) → False := by
