theorem Exp7.search_1949 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1949 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1949 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1949 → jacobiSym (-(q : ℤ)) l = -1) → False := by
