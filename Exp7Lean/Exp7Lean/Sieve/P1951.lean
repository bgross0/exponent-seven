/-- The instance `p = 1951` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1951 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1951 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1951 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1951 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
