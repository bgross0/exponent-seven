/-- The instance `p = 1979` of `Exp7.SearchHigh`. -/
theorem Exp7.search_1979 : ∀ x y q : ℕ, 1 ≤ y → 4 * 1979 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 1979 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 1979 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 1979 := by decide +kernel
  exact Exp7.Sieve.P1979.prime x y q hy hS (hQ.trans hq) h8 hj

