/-- The instance `p = 2543` of `Exp7.SearchHigh`. -/
theorem Exp7.search_2543 : ∀ x y q : ℕ, 1 ≤ y → 4 * 2543 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 2543 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 2543 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 2543 := by decide +kernel
  exact Exp7.Sieve.P2543.prime x y q hy hS (hQ.trans hq) h8 hj

