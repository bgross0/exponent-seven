/-- The instance `p = 2557` of `Exp7.SearchHigh`. -/
theorem Exp7.search_2557 : ∀ x y q : ℕ, 1 ≤ y → 4 * 2557 ^ 7 = x ^ 2 + q * y ^ 2 →
