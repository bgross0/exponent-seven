    (∀ l, l.Prime → 3 ≤ l → l < 2557 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 2557 := by decide +kernel
  exact Exp7.Sieve.P2557.prime x y q hy hS (hQ.trans hq) h8 hj

