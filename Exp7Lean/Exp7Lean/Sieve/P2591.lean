theorem Exp7.search_2591 : ∀ x y q : ℕ, 1 ≤ y → 4 * 2591 ^ 7 = x ^ 2 + q * y ^ 2 →
    Exp7.Qlo 2591 ≤ q → q % 8 = 3 →
    (∀ l, l.Prime → 3 ≤ l → l < 2591 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
