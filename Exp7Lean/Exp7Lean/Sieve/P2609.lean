    (∀ l, l.Prime → 3 ≤ l → l < 2609 → jacobiSym (-(q : ℤ)) l = -1) → False := by
  intro x y q hy hS hq h8 hj
  have hQ : (310000000000000000000 : ℕ) ≤ Exp7.Qlo 2609 := by decide +kernel
  exact Exp7.Sieve.P2609.prime x y q hy hS (hQ.trans hq) h8 hj

