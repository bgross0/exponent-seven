import Mathlib
import Exp7Lean.Sieve.RootsCert

/-!
# Kernel-checked examples for `Exp7.Roots`

Generated by a Python script (certificate generator + exact port of `rootsOf`); for the small
cases the Python port was compared with a brute-force enumeration of all residues, and the
brute-force enumeration is repeated here inside the kernel (`brute`).

`S211 = 4 * 211 ^ 7 = 74479573050050284` (here `211 ≡ 3 (mod 8)`),
`S73  = 4 * 73 ^ 7  = 44189594076388`   (here `73 ≡ 1 (mod 8)`, exercising the 2-adic lists).

All proofs are `decide +kernel`: no `native_decide`, no extra axioms.
-/

set_option linter.style.longLine false

namespace Exp7.Roots.Examples

open Exp7.Roots

/-- Brute-force list of all `x < m` with `x ^ 2 ≡ S (mod m)`, in increasing order. -/
def brute (S m : ℕ) : List ℕ :=
  liftF (fun x => Nat.beq (Nat.mod (Nat.mul x x) m) (Nat.mod S m)) 1 0 m []

/-- `brute` is complete (so comparing with it is a genuine cross-check). -/
theorem brute_complete {S m : ℕ} (hm : 0 < m) (x : ℕ) (hx : x ^ 2 ≡ S [MOD m]) :
    x % m ∈ brute S m := by
  have h := mem_liftF (P := fun x => Nat.beq (Nat.mod (Nat.mul x x) m) (Nat.mod S m))
    (m := 1) (r := 0) m [] (x % m) (Nat.mod_lt _ hm) (by
      have h1 : (x % m) * (x % m) ≡ S [MOD m] := by
        have := ((Nat.mod_modEq x m).pow 2).trans hx
        rwa [pow_two] at this
      have h2 : (0 + 1 * (x % m)) * (0 + 1 * (x % m)) % m = S % m := by
        rw [Nat.zero_add, Nat.one_mul]; exact h1
      change Nat.beq ((0 + 1 * (x % m)) * (0 + 1 * (x % m)) % m) (S % m) = true
      rw [h2]; exact Nat.beq_refl _)
  simpa [brute] using h

/-- Insertion sort, to compare `rootsOf` with `brute` as sets. -/
def ins (a : ℕ) : List ℕ → List ℕ
  | [] => [a]
  | b :: t => bif Nat.ble a b then a :: b :: t else b :: ins a t

/-- Insertion sort. -/
def sortL : List ℕ → List ℕ
  | [] => []
  | a :: t => ins a (sortL t)

/-! ## The requested cases, `S = 4 * 211 ^ 7` -/

/-! ### `y = 1`: 1 roots -/

/-- Certificate for `y = 1`. -/
def c211_1 : Cert :=
  ⟨0, 0, []⟩

example : rootsOk 74479573050050284 1 c211_1 = true := by decide +kernel

example : rootsOf 74479573050050284 c211_1 =
    [0] := by
  decide +kernel

example : rootsSoundB 74479573050050284 1 (rootsOf 74479573050050284 c211_1) = true := by decide +kernel

example : brute 74479573050050284 (1 * 1) = [0] := by
  decide +kernel

example : sortL (rootsOf 74479573050050284 c211_1) = brute 74479573050050284 (1 * 1) := by decide +kernel

example : rootsOf8 74479573050050284 1 c211_1 =
    [1, 3, 5, 7] := by
  decide +kernel

