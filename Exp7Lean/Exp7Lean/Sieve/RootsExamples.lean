/-! ## Using the theorems -/

/-- Every `x` with `35 ^ 2 ∣ 4 * 211 ^ 7 - x ^ 2` is `≡ 47, 247, 978, 1178 (mod 1225)`. -/
example (x : ℕ) (hx : ((35 : ℕ) : ℤ) ^ 2 ∣ ((4 * 211 ^ 7 : ℕ) : ℤ) - (x : ℤ) ^ 2) :
    x % 35 ^ 2 ∈ [1178, 978, 247, 47] := by
  have hok : rootsOk (4 * 211 ^ 7) 35 c211_35 = true := by decide +kernel
  have hl : rootsOf (4 * 211 ^ 7) c211_35 = [1178, 978, 247, 47] := by decide +kernel
  rw [← hl]
  exact rootsOf_complete_int hok x hx

/-- No `x` satisfies `999983 ^ 2 ∣ 4 * 211 ^ 7 - x ^ 2`. -/
example (x : ℕ) : ¬ x ^ 2 ≡ 4 * 211 ^ 7 [MOD 999983 ^ 2] :=
  noRoots_of_nonres (l := 999983) (by decide +kernel) x

