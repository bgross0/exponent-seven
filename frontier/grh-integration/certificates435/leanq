#!/usr/bin/env bash
# Adapter for the two pinned per-prime runners.
set -eu -o pipefail
if [[ $1 == --build ]]; then
  shift
  exec lake build "$@"
fi
if [[ $1 =~ ^Exp7Lean/(Sieve|SieveLow)/P([0-9]+)\.lean$ ]]; then
  family=${BASH_REMATCH[1]}
  prime=${BASH_REMATCH[2]}
  name="Exp7.search_$prime"
  if [[ $family == SieveLow ]]; then name="Exp7.searchLow_$prime"; fi
  dir=${EXP7_CERT_LOG_DIR:?}/$family
  mkdir -p "$dir"
  log=$(mktemp "$dir/P$prime.XXXXXX.log")
  # Direct lean invocations need the same elaboration budget as the pinned lakefile.
  lake env lean -DmaxHeartbeats=4000000 "$@" |& tee "$log"
  grep -Fxq "'$name' depends on axioms: [propext, Classical.choice, Quot.sound]" "$log"
else
  exec lake env lean "$@"
fi
