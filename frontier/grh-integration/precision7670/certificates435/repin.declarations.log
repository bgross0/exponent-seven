Exp7.theoremA_fundamental : Exp7.GRHPrimeConductor →
  Exp7.SearchHigh →
    ∀ (a b : ℤ),
      (QuadraticAlgebra.discr a b).IsFundamentalDiscr →
        QuadraticAlgebra.discr a b < 0 →
          ∀ [inst : IsDomain (QuadraticAlgebra ℤ a b)],
            ↑Exp7.QLOW ≤ -QuadraticAlgebra.discr a b →
              -QuadraticAlgebra.discr a b ≤ ↑Exp7.QTOP → Monoid.exponent (ClassGroup (QuadraticAlgebra ℤ a b)) ≠ 7
'Exp7.theoremA_fundamental' depends on axioms: [propext, Classical.choice, Quot.sound]
Exp7.theoremD_fundamental : Exp7.GRHPrimeConductor →
  Exp7.SearchHigh →
    Exp7.SearchLow →
      ∀ (a b : ℤ),
        (QuadraticAlgebra.discr a b).IsFundamentalDiscr →
          QuadraticAlgebra.discr a b < 0 →
            ∀ [inst : IsDomain (QuadraticAlgebra ℤ a b)],
              -QuadraticAlgebra.discr a b ≤ ↑Exp7.QTOP →
                (Monoid.exponent (ClassGroup (QuadraticAlgebra ℤ a b)) = 7 ↔
                  ∃ q ∈ Exp7.known, QuadraticAlgebra.discr a b = -↑q)
'Exp7.theoremD_fundamental' depends on axioms: [propext, Classical.choice, Quot.sound]
