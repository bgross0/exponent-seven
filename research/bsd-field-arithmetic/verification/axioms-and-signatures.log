Exp7.K71.twoClass_pow_seven : Exp7.K71.twoClass ^ 7 = 1
Exp7.K71.twoClass_ne_one : Exp7.K71.twoClass ≠ 1
Exp7.K71.twoClass_order : orderOf Exp7.K71.twoClass = 7
Exp7.K71.threeClass_eq_twoClass_cube : Exp7.K71.threeClass = Exp7.K71.twoClass ^ 3
