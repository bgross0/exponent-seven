Exp7.SeventyOneLocal.alpha_eq : Exp7.SeventyOneLocal.alpha = 10 + QuadraticAlgebra.omega
Exp7.SeventyOneLocal.norm_alpha : QuadraticAlgebra.norm Exp7.SeventyOneLocal.alpha = 128
