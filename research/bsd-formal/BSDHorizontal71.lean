variable {R S : Type*} [CommRing R] [CommRing S]

/-- The coefficient rows are in ascending powers of the second variable. -/
def bivariateValue (cs : List (List ℤ)) (x y : R) : R :=
  cs.foldr (fun c z => (integerPolynomial R c).eval x + y * z) 0

def horizontalPolynomial (x : R) : Polynomial R :=
  horizontalCoefficients.foldr
    (fun c f => Polynomial.C ((integerPolynomial R c).eval x) + Polynomial.X * f) 0

def horizontalDerivativeCoefficients : List (List ℤ) :=
  [horizontalCoefficients[1]!, [2 * (commonDenominator : ℤ)]]

theorem bivariateValue_map (f : R →+* S) (cs : List (List ℤ)) (x y : R) :
    f (bivariateValue cs x y) = bivariateValue cs (f x) (f y) := by
  induction cs with
  | nil => simp [bivariateValue]
  | cons c cs ih =>
      simp only [bivariateValue] at ih
      simp only [bivariateValue, List.foldr_cons, map_add, map_mul,
        map_integerPolynomial_eval, ih]

theorem horizontalPolynomial_eval (x y : R) :
    (horizontalPolynomial x).eval y = bivariateValue horizontalCoefficients x y := by
  simp only [horizontalPolynomial, horizontalCoefficients, bivariateValue,
    List.foldr_cons, List.foldr_nil, eval_add, eval_C, eval_mul, eval_X, eval_zero]

theorem horizontalPolynomial_derivative_eval (x y : R) :
    (horizontalPolynomial x).derivative.eval y =
      bivariateValue horizontalDerivativeCoefficients x y := by
  simp [horizontalPolynomial, horizontalDerivativeCoefficients, horizontalCoefficients,
    commonDenominator, bivariateValue, integerPolynomial, derivative_add, derivative_mul]
  ring

/-- An integer identity, valid over every commutative ring. No CM assumption. -/
theorem modular_factor_identity (x y : R) :
    (commonDenominator : R) ^ 2 * classicalPhi2 x y =
      bivariateValue horizontalCoefficients x y *
        bivariateValue verticalCoefficients x y +
      (integerPolynomial R candidate71Coefficients).eval x *
        bivariateValue modularRemainderCoefficients x y := by
  simp only [bivariateValue, horizontalCoefficients, verticalCoefficients,
    modularRemainderCoefficients, integerPolynomial, candidate71Coefficients,
    commonDenominator, classicalPhi2, List.foldr_cons, List.foldr_nil,
    eval_add, eval_C, eval_mul, eval_X, eval_zero]
  ring

/-- The same quadratic divides H71(Y) whenever H71(X)=0 and D is a unit. -/
theorem class_factor_identity (x y : R) :
    (commonDenominator : R) ^ 2 *
      (integerPolynomial R candidate71Coefficients).eval y =
      bivariateValue horizontalCoefficients x y *
        bivariateValue cofactorCoefficients x y +
      (integerPolynomial R candidate71Coefficients).eval x *
        bivariateValue classRemainderCoefficients x y := by
  simp only [bivariateValue, horizontalCoefficients, cofactorCoefficients,
    classRemainderCoefficients, integerPolynomial, candidate71Coefficients,
    commonDenominator, List.foldr_cons, List.foldr_nil,
    eval_add, eval_C, eval_mul, eval_X, eval_zero]
  ring

/-- A root of the quadratic is simultaneously an H71 root and an exact
Phi_2 neighbor. Only unit cancellation, not a domain assumption, is used. -/
theorem horizontal_root_spec (x y : R)
    (hD : IsUnit (commonDenominator : R))
    (hx : (integerPolynomial R candidate71Coefficients).eval x = 0)
    (hq : (horizontalPolynomial x).eval y = 0) :
    (integerPolynomial R candidate71Coefficients).eval y = 0 ∧
      classicalPhi2 x y = 0 := by
  rw [horizontalPolynomial_eval] at hq
  constructor
  · apply (hD.pow 2).mul_left_cancel
    simpa only [hq, hx, zero_mul, add_zero, mul_zero] using class_factor_identity x y
  · apply (hD.pow 2).mul_left_cancel
    simpa only [hq, hx, zero_mul, add_zero, mul_zero] using modular_factor_identity x y

/-- Simple-root uniqueness for an adically complete commutative ring. -/
theorem simple_root_unique {A : Type*} [CommRing A]
    (I : Ideal A) [IsAdicComplete I A] (f : Polynomial A) {a b : A}
    (ha : f.eval a = 0) (hb : f.eval b = 0) (hab : b - a ∈ I)
    (hder : IsUnit (Ideal.Quotient.mk I (f.derivative.eval a))) : a = b := by
  obtain ⟨c, hc⟩ := exists_mul_sq_add_linear_part_eq_eval_add f a (b - a)
  have he : (c * (b - a) + f.derivative.eval a) * (b - a) = 0 := by
    calc
      _ = c * (b - a) ^ 2 + f.derivative.eval a * (b - a) + f.eval a := by
        rw [ha]
        ring
      _ = f.eval (a + (b - a)) := hc
      _ = 0 := by simpa only [add_sub_cancel] using hb
  have hu : IsUnit (c * (b - a) + f.derivative.eval a) := by
    have := isLocalHom_of_le_jacobson (IsAdicComplete.le_jacobson I)
    apply IsUnit.of_map (Ideal.Quotient.mk I)
    have hz : Ideal.Quotient.mk I (b - a) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hab
    simpa only [map_add, map_mul, hz, mul_zero, zero_add] using hder
  have he' : b - a = 0 := hu.mul_left_cancel (by simpa using he)
  exact (sub_eq_zero.mp he').symm

/-- Integer coefficient evaluation through the existing pair arithmetic. -/
def integerEvaluateMod (m : ℕ) (cs : List ℤ) (a : Pair) : Pair :=
  evaluateMod m (cs.map (fun c => scaleMod m c (1, 0))) a

def bivariateMod (m : ℕ) (cs : List (List ℤ)) (a b : Pair) : Pair :=
  evaluateMod m (cs.map (fun row => integerEvaluateMod m row a)) b

theorem evalPair_integerEvaluateMod (m : ℕ) (hm : (m : R) = 0) (hmpos : 0 < m)
    (u : R) (hu : u ^ 2 = 5) (cs : List ℤ) (a : Pair) :
    evalPair u (integerEvaluateMod m cs a) =
      (integerPolynomial R cs).eval (evalPair u a) := by
  rw [integerEvaluateMod, evalPair_evaluateMod m hm u hu]
  have hh : coefficientPolynomial u (cs.map (fun c => scaleMod m c (1, 0))) =
      integerPolynomial R cs := by
    induction cs with
    | nil => rfl
    | cons c cs ih =>
        simp only [coefficientPolynomial, integerPolynomial] at ih
        simp only [List.map_cons, coefficientPolynomial, integerPolynomial,
          List.foldr_cons, evalPair_scaleMod m hm hmpos, evalPair_one, mul_one,
          ih]
  rw [hh]

theorem evalPair_bivariateMod (m : ℕ) (hm : (m : R) = 0) (hmpos : 0 < m)
    (u : R) (hu : u ^ 2 = 5) (cs : List (List ℤ)) (a b : Pair) :
    evalPair u (bivariateMod m cs a b) =
      bivariateValue cs (evalPair u a) (evalPair u b) := by
  induction cs with
  | nil => simp [bivariateMod, evaluateMod, bivariateValue, evalPair_zero]
  | cons c cs ih =>
      simp only [bivariateMod, List.map_cons, evaluateMod, evalPair_addMod m hm,
        evalPair_mulMod m hm u hu, evalPair_integerEvaluateMod m hm hmpos u hu,
        bivariateValue, List.foldr_cons] at *
      rw [ih]
      ring

theorem horizontal_mod_and_simple : ∀ i j : Fin 7,
    j.val ∈ cm71Graph433[i.val]! →
    bivariateMod (433 ^ 4) horizontalCoefficients cm71Roots433[i.val]!
      cm71Roots433[j.val]! = (0, 0) ∧
    Nat.Coprime (quadraticNormResidue
      (bivariateMod (433 ^ 4) horizontalDerivativeCoefficients
        cm71Roots433[i.val]! cm71Roots433[j.val]!)) (433 ^ 4) := by
  decide +kernel

theorem derivative71_canonical_unit : ∀ j : Fin 7,
    Nat.Coprime (quadraticNormResidue
      (integerEvaluateMod (433 ^ 4) (formalDerivative candidate71Coefficients)
        cm71Roots433[j.val]!)) (433 ^ 4) := by
  decide +kernel

theorem nonedge_mod_unit : ∀ i j : Fin 7,
    j.val ∉ cm71Graph433[i.val]! →
    Nat.Coprime (quadraticNormResidue
      (phi2Mod (433 ^ 4) cm71Roots433[i.val]! cm71Roots433[j.val]!)) (433 ^ 4) := by
  decide +kernel

abbrev CompletionQuotient := QuadraticCompletion ⧸ completedIdeal

def residueHom : QuadraticCompletion →+* CompletionQuotient :=
  Ideal.Quotient.mk completedIdeal

theorem residue_generator_sq : (residueHom quadraticGenerator) ^ 2 = 5 := by
  rw [← map_pow, quadraticGenerator_sq, map_ofNat]

theorem residue_root71 (i : Fin 7) :
    residueHom (root71 i) =
      evalPair (residueHom quadraticGenerator) cm71Roots433[i.val]! :=
  root71_canonical_residue i

theorem bivariate_roots_residue (cs : List (List ℤ)) (i j : Fin 7) :
    residueHom (bivariateValue cs (root71 i) (root71 j)) =
      evalPair (residueHom quadraticGenerator)
        (bivariateMod (433 ^ 4) cs cm71Roots433[i.val]! cm71Roots433[j.val]!) := by
  rw [bivariateValue_map, residue_root71, residue_root71]
  exact (evalPair_bivariateMod (433 ^ 4) quotient_modulus_zero (by norm_num)
    _ residue_generator_sq _ _ _).symm

theorem commonDenominator_isUnit :
    IsUnit (commonDenominator : QuadraticCompletion) := by
  have := isLocalHom_of_le_jacobson (IsAdicComplete.le_jacobson completedIdeal)
  apply IsUnit.of_map (Ideal.Quotient.mk completedIdeal)
  have hc : Nat.Coprime (quadraticNormResidue (commonDenominator, 0)) (433 ^ 4) := by
    decide +kernel
  have h := evalPair_isUnit_of_norm_coprime (residueHom quadraticGenerator)
    residue_generator_sq (commonDenominator, 0) quotient_modulus_zero hc
  simpa only [evalPair, Nat.cast_zero, zero_mul, add_zero, map_natCast] using h

theorem root71_derivative_unit (j : Fin 7) :
    IsUnit (residueHom
      ((integerPolynomial QuadraticCompletion candidate71Coefficients).derivative.eval
        (root71 j))) := by
  rw [← integerPolynomial_formalDerivative, map_integerPolynomial_eval, residue_root71]
  rw [← evalPair_integerEvaluateMod (433 ^ 4) quotient_modulus_zero (by norm_num)
    _ residue_generator_sq]
  exact evalPair_isUnit_of_norm_coprime _ residue_generator_sq _ quotient_modulus_zero
    (derivative71_canonical_unit j)

/-- Every certified finite edge is an exact Phi_2 equation between the
already-constructed roots of the full degree-seven candidate polynomial. -/
theorem root71_horizontal_edge (i j : Fin 7)
    (hij : j.val ∈ cm71Graph433[i.val]!) :
    classicalPhi2 (root71 i) (root71 j) = 0 := by
  obtain ⟨hres, hder⟩ := horizontal_mod_and_simple i j hij
  have hQ : (horizontalPolynomial (root71 i)).eval (root71 j) ∈ completedIdeal := by
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change residueHom ((horizontalPolynomial (root71 i)).eval (root71 j)) = 0
    rw [horizontalPolynomial_eval, bivariate_roots_residue, hres, evalPair_zero]
  have hQder : IsUnit (Ideal.Quotient.mk completedIdeal
      ((horizontalPolynomial (root71 i)).derivative.eval (root71 j))) := by
    change IsUnit (residueHom
      ((horizontalPolynomial (root71 i)).derivative.eval (root71 j)))
    rw [horizontalPolynomial_derivative_eval, bivariate_roots_residue]
    exact evalPair_isUnit_of_norm_coprime _ residue_generator_sq _ quotient_modulus_zero hder
  obtain ⟨b, hb, hbj⟩ := simple_root_in_complete_ring completedIdeal
    (horizontalPolynomial (root71 i)) (root71 j) hQ hQder
  have hspec := horizontal_root_spec (root71 i) b commonDenominator_isUnit
    (root71_spec i).1 hb
  have heq : root71 j = b := simple_root_unique completedIdeal
    (integerPolynomial QuadraticCompletion candidate71Coefficients)
    (root71_spec j).1 hspec.1 hbj (root71_derivative_unit j)
  rw [heq]
  exact hspec.2

theorem classicalPhi2_map (f : R →+* S) (x y : R) :
    f (classicalPhi2 x y) = classicalPhi2 (f x) (f y) := by
  simp only [classicalPhi2, map_add, map_sub, map_mul, map_pow, map_ofNat]

/-- The nonedges are units, so they cannot vanish even without a domain
instance for the completion used for the root construction. -/
theorem root71_nonedge_isUnit (i j : Fin 7)
    (hij : j.val ∉ cm71Graph433[i.val]!) :
    IsUnit (classicalPhi2 (root71 i) (root71 j)) := by
  have := isLocalHom_of_le_jacobson (IsAdicComplete.le_jacobson completedIdeal)
  apply IsUnit.of_map (Ideal.Quotient.mk completedIdeal)
  change IsUnit (residueHom (classicalPhi2 (root71 i) (root71 j)))
  rw [classicalPhi2_map, residue_root71, residue_root71]
  rw [← evalPair_phi2Mod (433 ^ 4) quotient_modulus_zero (by norm_num)
    _ residue_generator_sq]
  exact evalPair_isUnit_of_norm_coprime _ residue_generator_sq _ quotient_modulus_zero
    (nonedge_mod_unit i j hij)

/-- Complete exact adjacency among the seven existing roots. The right-hand
side is the explicitly verified seven-cycle, not an assumed correspondence. -/
theorem root71_exact_graph (i j : Fin 7) :
    classicalPhi2 (root71 i) (root71 j) = 0 ↔ j.val ∈ cm71Graph433[i.val]! := by
  constructor
  · intro hzero
    by_contra hnot
    have hu := root71_nonedge_isUnit i j hnot
    rw [hzero] at hu
    exact not_isUnit_zero hu
  · exact root71_horizontal_edge i j

/-- The cycle order already used by the finite CM-value calculation. -/
def cycleIndex (i : Fin 7) : Fin 7 :=
  ⟨cm71Cycle433[i.val]!, (by
    have h : ∀ j : Fin 7, cm71Cycle433[j.val]! < 7 := by decide +kernel
    exact h i)⟩

theorem cycleIndex_injective : Function.Injective cycleIndex := by
  decide +kernel

/-- In the displayed cyclic order, exact adjacency is precisely addition or
subtraction of one in Fin 7. -/
theorem root71_exact_cycle (i j : Fin 7) :
    classicalPhi2 (root71 (cycleIndex i)) (root71 (cycleIndex j)) = 0 ↔
      j = i + 1 ∨ i = j + 1 := by
  rw [root71_exact_graph]
  have h : ∀ i j : Fin 7,
      (cycleIndex j).val ∈ cm71Graph433[(cycleIndex i).val]! ↔
        j = i + 1 ∨ i = j + 1 := by decide +kernel
  exact h i j

theorem root71_cycle_injective :
    Function.Injective (fun i : Fin 7 => root71 (cycleIndex i)) :=
  root71_injective.comp cycleIndex_injective

end BSDHorizontal71
