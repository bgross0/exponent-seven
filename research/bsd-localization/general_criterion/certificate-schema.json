{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bsd-projective-line-separation/v1",
  "title": "Finite projective line-separation input",
  "description": "This schema records claimed p-adic precision and provenance. Only the finite arithmetic is verified by certificate_checker.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ring", "basis_id", "error_ideal", "analytic", "exceptional", "source_bindings"],
  "properties": {
    "schema": {"const": "bsd-projective-line-separation/v1"},
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "precision", "modulus_polynomial"],
      "properties": {
        "p": {"type": "integer", "minimum": 3, "maximum": 2147483647},
        "precision": {"type": "integer", "minimum": 1, "maximum": 1024},
        "modulus_polynomial": {
          "type": "array", "minItems": 2, "maxItems": 65,
          "items": {"type": "integer"},
          "description": "Integer coefficients in increasing degree; last coefficient must equal1; reduction must be irreducible."
        }
      }
    },
    "basis_id": {"type": "string", "minLength": 1},
    "error_ideal": {"const": "p^N O_L^2"},
    "analytic": {"$ref": "#/$defs/vector"},
    "exceptional": {"$ref": "#/$defs/vector"},
    "source_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["analytic_leading_term", "exceptional_line", "common_basis", "precision"],
      "properties": {
        "analytic_leading_term": {"type": "string", "minLength": 1},
        "exceptional_line": {"type": "string", "minLength": 1},
        "common_basis": {"type": "string", "minLength": 1},
        "precision": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object", "additionalProperties": false,
      "required": ["basis_id", "coordinates", "normalization"],
      "properties": {
        "basis_id": {"type": "string", "minLength": 1},
        "coordinates": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 0}}
        },
        "normalization": {"type": "string", "minLength": 1}
      }
    }
  },
  "$comment": "The Python checker additionally verifies primality, irreducibility, monicity, common basis identifiers, degree-dependent coordinate lengths, p^N-dependent residue bounds, and primitivity. Provenance strings are not mathematical proofs."
}
